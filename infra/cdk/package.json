{
  "name": "@borso/infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/internal/cf-host-routing-function.code.js dist/internal/cf-host-routing-function.code.js && cp src/internal/cf-static-site-index-rewrite.code.js dist/internal/cf-static-site-index-rewrite.code.js",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && eslint infra/cdk --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.0.0"
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
