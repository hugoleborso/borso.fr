{
  "name": "@borso/shared-infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "synth": "pnpm --filter @borso/infra run build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "typecheck": "../../scripts/ensure-infra-built.sh && node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "../../scripts/lint-workspace.sh",
    "test": "pnpm --filter @borso/infra run build && vitest run",
    "test:coverage": "pnpm --filter @borso/infra run build && vitest run --coverage"
  },
  "dependencies": {
    "@borso/infra": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  }
}
