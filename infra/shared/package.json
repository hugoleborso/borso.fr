{
  "name": "@borso/shared-infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "synth": "pnpm --filter @borso/infra run build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && eslint infra/shared --cache --cache-location node_modules/.cache/eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@borso/infra": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "^2.1135.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.7.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
