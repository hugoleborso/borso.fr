save-exact=true
auto-install-peers=true
fail-if-no-match=true
# pnpm installs before `pnpm run` or `pnpm exec` when node_modules no longer
# matches the lockfile or a manifest. A session moved to a newer main ran its
# typecheck on modules it never installed (PR #431). Git hooks call
# node_modules/.bin directly, so they keep scripts/ensure-installed.sh.
verify-deps-before-run=install
