{
  "name": "@borso-app/pragma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:db > /dev/null && concurrently -k -n api,site -c magenta,green 'pnpm dev:api' 'pnpm dev:site'",
    "dev:db": "../../scripts/local-postgres.sh start pragma",
    "dev:api": "DATABASE_URL=$(../../scripts/local-postgres.sh start pragma) STAGE=dev ALLOW_TEST_SEED=1 tsx watch api/src/main.dev.ts",
    "dev:site": "vite",
    "db:local:start": "../../scripts/local-postgres.sh start pragma",
    "db:local:stop": "../../scripts/local-postgres.sh stop pragma",
    "db:local:wipe": "../../scripts/local-postgres.sh wipe pragma",
    "db:local:url": "../../scripts/local-postgres.sh url pragma",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "cd ../.. && eslint apps/pragma --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc -p tsconfig.cdk.json --noEmit && tsc --noEmit",
    "test:core": "pnpm --filter @borso/infra run build && vitest run --project core --coverage",
    "test": "DATABASE_URL=$(../../scripts/local-postgres.sh start pragma) vitest run --project back-e2e",
    "test:coverage": "pnpm --filter @borso/infra run build && DATABASE_URL=$(../../scripts/local-postgres.sh start pragma) vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "synth": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy \"pragma-pr-${PR_NUMBER:?PR_NUMBER env var required \u2014 pragma destroy targets the per-PR app stack only, never the shared pragma-cluster stack}\" --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/dsql-signer": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@borso/infra": "workspace:*",
    "@dnd-kit/core": "6",
    "@dnd-kit/sortable": "10",
    "@dnd-kit/utilities": "3",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "@hono/zod-validator": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "hash-wasm": "^4.11.0",
    "hono": "catalog:",
    "i18next": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "^7",
    "tailwindcss": "catalog:",
    "zod": "catalog:zod3"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "concurrently": "catalog:",
    "constructs": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
