{
  "name": "@borso-app/borsouvertures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "../../scripts/lint-workspace.sh",
    "typecheck": "../../scripts/ensure-infra-built.sh && tsc -p tsconfig.cdk.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.cdk.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:full-suite": "vitest run",
    "build:openings": "tsx scripts/build-openings.ts",
    "synth": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy --all --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@borso/infra": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "chess.js": "^1.0.0",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-chessboard": "^5.12.1",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "tailwindcss": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "catalog:"
  }
}
