{
  "name": "@borso-app/borsouvertures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:db && concurrently -k -n api,site -c cyan,green 'pnpm dev:api' 'pnpm dev:site'",
    "dev:db": "DATABASE_URL=$(../../scripts/local-postgres.sh start borsouvertures dev) tsx test/dev-database.setup.ts",
    "dev:api": "DATABASE_URL=$(../../scripts/local-postgres.sh start borsouvertures dev) STAGE=dev tsx watch api/src/main.dev.ts",
    "dev:site": "tsx scripts/build-decks.setup.ts && vite",
    "db:local:start": "../../scripts/local-postgres.sh start borsouvertures",
    "db:local:stop": "../../scripts/local-postgres.sh stop borsouvertures",
    "db:local:wipe": "../../scripts/local-postgres.sh wipe borsouvertures",
    "db:local:url": "../../scripts/local-postgres.sh url borsouvertures",
    "build": "tsx scripts/build-decks.setup.ts && vite build",
    "preview": "vite preview",
    "lint": "../../scripts/lint-workspace.sh",
    "typecheck": "../../scripts/ensure-infra-built.sh && tsc -p tsconfig.cdk.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.cdk.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "test:core": "pnpm --filter @borso/infra run build && vitest run --project core",
    "test:e2e": "DATABASE_URL=$(../../scripts/local-postgres.sh start borsouvertures) vitest run --project back-e2e",
    "test:full-suite": "pnpm run test:core && pnpm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "build:openings": "tsx scripts/build-openings.ts",
    "build:decks": "tsx scripts/build-decks.setup.ts",
    "check:decks": "tsx scripts/check-decks.setup.ts",
    "build:traps": "tsx scripts/build-traps.setup.ts",
    "synth": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy \"borsouvertures-pr-${PR_NUMBER:?PR_NUMBER env var required. borsouvertures destroy targets the per-PR app stack only, never the shared borsouvertures-cluster stack}\" --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "catalog:",
    "@borso/infra": "workspace:*",
    "@hono/aws-lambda": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@sentry/aws-serverless": "catalog:",
    "@sentry/react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "chess.js": "^1.0.0",
    "drizzle-orm": "catalog:",
    "hash-wasm": "catalog:",
    "hono": "catalog:",
    "i18next": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-chessboard": "^5.12.1",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "tailwindcss": "catalog:",
    "ts-fsrs": "6.0.0",
    "workbox-window": "^7.4.1",
    "zod": "catalog:zod4"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "concurrently": "catalog:",
    "constructs": "catalog:",
    "drizzle-kit": "catalog:",
    "fake-indexeddb": "6.2.8",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "catalog:",
    "workbox-build": "7.4.1"
  }
}
