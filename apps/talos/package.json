{
  "name": "@borso-app/talos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:db && concurrently -k -n api,site -c magenta,green 'pnpm dev:api' 'pnpm dev:site'",
    "dev:db": "DATABASE_URL=$(../../scripts/local-postgres.sh start talos dev) tsx test/dev-database.setup.ts",
    "dev:api": "DATABASE_URL=$(../../scripts/local-postgres.sh start talos dev) STAGE=dev tsx watch api/src/main.dev.ts",
    "dev:site": "vite",
    "db:local:start": "../../scripts/local-postgres.sh start talos",
    "db:local:stop": "../../scripts/local-postgres.sh stop talos",
    "db:local:wipe": "../../scripts/local-postgres.sh wipe talos",
    "db:local:url": "../../scripts/local-postgres.sh url talos",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "cd ../.. && eslint apps/talos --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc -p tsconfig.cdk.json --noEmit && tsc --noEmit",
    "test:core": "pnpm --filter @borso/infra run build && vitest run --project core --coverage",
    "test": "DATABASE_URL=$(../../scripts/local-postgres.sh start talos) vitest run --project back-e2e",
    "test:coverage": "pnpm --filter @borso/infra run build && DATABASE_URL=$(../../scripts/local-postgres.sh start talos) vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "synth": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy \"talos-pr-${PR_NUMBER:?PR_NUMBER env var required — talos destroy targets a per-PR app stack only, never talos-prod or the shared talos-cluster stack}\" --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "catalog:",
    "@aws-sdk/dsql-signer": "catalog:",
    "@borso/infra": "workspace:*",
    "@hono/zod-validator": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dompurify": "3.4.16",
    "drizzle-orm": "catalog:",
    "force-graph": "1.52.0",
    "hono": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "1.52.0",
    "marked": "18.0.14",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:",
    "tailwindcss": "catalog:",
    "web-push": "3.6.7",
    "zod": "catalog:zod4"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "concurrently": "catalog:",
    "constructs": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "borso": {
    "previews": false
  }
}
