{
  "name": "@borso-app/borso-fr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "cd ../.. && eslint apps/borso-fr --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc -p tsconfig.cdk.json --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "screenshot": "node scripts/screenshot.mjs",
    "synth": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy --all --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@borso/infra": "workspace:*",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@tailwindcss/vite": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "ogl": "1.0.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "jsdom": "catalog:",
    "playwright": "^1.49.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
