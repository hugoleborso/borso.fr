{
  "name": "@borso-app/skull-king",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:db && concurrently -k -n api,site -c yellow,green 'pnpm dev:api' 'pnpm dev:site'",
    "dev:db": "DATABASE_URL=$(../../scripts/local-postgres.sh start skull-king dev) tsx test/dev-database.setup.ts",
    "dev:api": "DATABASE_URL=$(../../scripts/local-postgres.sh start skull-king dev) STAGE=dev tsx watch api/src/main.dev.ts",
    "dev:site": "vite",
    "db:local:start": "../../scripts/local-postgres.sh start skull-king",
    "db:local:stop": "../../scripts/local-postgres.sh stop skull-king",
    "db:local:wipe": "../../scripts/local-postgres.sh wipe skull-king",
    "db:local:url": "../../scripts/local-postgres.sh url skull-king",
    "build": "vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "lint": "../../scripts/lint-workspace.sh",
    "typecheck": "../../scripts/ensure-infra-built.sh && tsc -p tsconfig.cdk.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.cdk.tsbuildinfo && tsc -p tsconfig.sw.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.sw.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "test:core": "pnpm --filter @borso/infra run build && vitest run --project core",
    "test:e2e": "DATABASE_URL=$(../../scripts/local-postgres.sh start skull-king) vitest run --project back-e2e",
    "test:full-suite": "pnpm run test:core && pnpm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "synth": "../../scripts/ensure-infra-built.sh && pnpm build && cdk synth --all",
    "diff": "pnpm --filter @borso/infra run build && pnpm build && cdk diff --all",
    "deploy": "pnpm --filter @borso/infra run build && pnpm build && cdk synth --all && ../../scripts/preflight-cloudfront-aliases.sh cdk.out && cdk deploy --all --require-approval never",
    "destroy": "pnpm --filter @borso/infra run build && pnpm build && cdk destroy \"skull-king-pr-${PR_NUMBER:?PR_NUMBER env var required \u2014 skull-king destroy targets the per-PR app stack only, never the shared skull-king-cluster stack}\" --force",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "catalog:",
    "@aws-sdk/dsql-signer": "catalog:",
    "@borso/infra": "workspace:*",
    "@hono/aws-lambda": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@sentry/aws-serverless": "catalog:",
    "@sentry/react": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "i18next": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:zod4"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "aws-cdk": "catalog:",
    "aws-cdk-lib": "catalog:",
    "concurrently": "catalog:",
    "constructs": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
