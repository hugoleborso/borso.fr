<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PragmaPrepareConcert" targetNamespace="https://pragma.borso.fr/bpmn" exporter="bpmn-io toolchain" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_PrepareConcert">
    <bpmn:participant id="Participant_Member" name="Band member, pragma.borso.fr (PWA)" processRef="Process_PrepareConcert" />
    <bpmn:participant id="Participant_Api" name="Pragma API, Hono on Lambda + Aurora DSQL" />
    <bpmn:participant id="Participant_Musicbrainz" name="MusicBrainz, rate-limited and cached" />
    <bpmn:participant id="Participant_ChartsBucket" name="Charts bucket, S3 presigned PUT" />
    <bpmn:messageFlow id="MessageFlow_Login" name="shared password" sourceRef="Task_EnterPassword" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_CreateConcert" name="concert" sourceRef="Task_CreateConcert" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_CreateSetlist" name="setlist + session link" sourceRef="Task_CreateSetlist" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_Search" name="recording search" sourceRef="Task_SearchMusicbrainz" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_SearchUpstream" name="search request" sourceRef="Participant_Api" targetRef="Participant_Musicbrainz" />
    <bpmn:messageFlow id="MessageFlow_RankedMatches" name="ranked matches" sourceRef="Participant_Musicbrainz" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_Presign" name="presign request" sourceRef="Task_RequestPresign" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_UploadChart" name="chart file PUT" sourceRef="Task_UploadChart" targetRef="Participant_ChartsBucket" />
    <bpmn:messageFlow id="MessageFlow_AppendEntry" name="append entry" sourceRef="Task_AppendEntry" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_Reorder" name="new order" sourceRef="Task_ReorderEntries" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_FixGap" name="override or comment" sourceRef="Task_FixRiskyGap" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_Practice" name="practice for the concert" sourceRef="Task_SchedulePractice" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_Manifest" name="offline manifest" sourceRef="Task_PrecacheManifest" targetRef="Participant_Api" />
    <bpmn:messageFlow id="MessageFlow_BarStatus" name="bar status update" sourceRef="Task_MarkBarPlayed" targetRef="Participant_Api" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PrepareConcert" isExecutable="false">
    <bpmn:startEvent id="Event_ConcertBooked" name="Concert booked with a bar">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_OpenApp" name="Open pragma.borso.fr">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCookieCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CookieValid" name="Sign-in cookie still valid?">
      <bpmn:incoming>Flow_ToCookieCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CookieYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CookieNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinLoginAttempt">
      <bpmn:incoming>Flow_CookieNo</bpmn:incoming>
      <bpmn:incoming>Flow_WrongPassword</bpmn:incoming>
      <bpmn:incoming>Flow_WindowElapsed</bpmn:incoming>
      <bpmn:outgoing>Flow_TryPassword</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterPassword" name="Enter the shared password">
      <bpmn:incoming>Flow_TryPassword</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitPassword</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PasswordOutcome" name="Password accepted?">
      <bpmn:incoming>Flow_SubmitPassword</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_WrongPassword</bpmn:outgoing>
      <bpmn:outgoing>Flow_RateLimited</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_RateLimitWindow" name="15 min rate-limit window">
      <bpmn:incoming>Flow_RateLimited</bpmn:incoming>
      <bpmn:outgoing>Flow_WindowElapsed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_RateLimitWindow_timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinSignedIn">
      <bpmn:incoming>Flow_CookieYes</bpmn:incoming>
      <bpmn:incoming>Flow_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_SignedIn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CreateConcert" name="Create the concert: venue, capacity, date">
      <bpmn:incoming>Flow_SignedIn</bpmn:incoming>
      <bpmn:outgoing>Flow_ConcertCreated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreateSetlist" name="Create a setlist attached to the concert">
      <bpmn:incoming>Flow_ConcertCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_SetlistCreated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinReorder">
      <bpmn:incoming>Flow_SetlistFilled</bpmn:incoming>
      <bpmn:incoming>Flow_RetryReorder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReorder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReorderEntries" name="Reorder the entries into an energy arc">
      <bpmn:incoming>Flow_ToReorder</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderSaved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_ReorderStale" name="Reorder rejected as stale" attachedToRef="Task_ReorderEntries">
      <bpmn:outgoing>Flow_StaleCaught</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Event_ReorderStale_error" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ReloadEntries" name="Reload the stored entries">
      <bpmn:incoming>Flow_StaleCaught</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryReorder</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_ForkChecks">
      <bpmn:incoming>Flow_OrderSaved</bpmn:incoming>
      <bpmn:outgoing>Flow_ForkTransitions</bpmn:outgoing>
      <bpmn:outgoing>Flow_ForkMastery</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ReviewTransitions" name="Review the transition between consecutive songs">
      <bpmn:incoming>Flow_ForkTransitions</bpmn:incoming>
      <bpmn:outgoing>Flow_TransitionsReviewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TransitionsCovered" name="Harmonic carrier across every gap?">
      <bpmn:incoming>Flow_TransitionsReviewed</bpmn:incoming>
      <bpmn:outgoing>Flow_AllCovered</bpmn:outgoing>
      <bpmn:outgoing>Flow_RiskyGap</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixRiskyGap" name="Adjust the lineup override or comment the gap">
      <bpmn:incoming>Flow_RiskyGap</bpmn:incoming>
      <bpmn:outgoing>Flow_GapHandled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinTransitions">
      <bpmn:incoming>Flow_AllCovered</bpmn:incoming>
      <bpmn:incoming>Flow_GapHandled</bpmn:incoming>
      <bpmn:outgoing>Flow_TransitionsDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckMastery" name="Check the mastery of each song lineup">
      <bpmn:incoming>Flow_ForkMastery</bpmn:incoming>
      <bpmn:outgoing>Flow_MasteryChecked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MasteryAbovePar" name="Every song above par?">
      <bpmn:incoming>Flow_MasteryChecked</bpmn:incoming>
      <bpmn:outgoing>Flow_MasteryFine</bpmn:outgoing>
      <bpmn:outgoing>Flow_WeakSpot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SchedulePractice" name="Schedule a practice aimed at the concert">
      <bpmn:incoming>Flow_WeakSpot</bpmn:incoming>
      <bpmn:outgoing>Flow_PracticePlanned</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinMastery">
      <bpmn:incoming>Flow_MasteryFine</bpmn:incoming>
      <bpmn:incoming>Flow_PracticePlanned</bpmn:incoming>
      <bpmn:outgoing>Flow_MasteryDone</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_JoinChecks">
      <bpmn:incoming>Flow_TransitionsDone</bpmn:incoming>
      <bpmn:incoming>Flow_MasteryDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ChecksDone</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_PrecacheManifest" name="Service worker pre-caches the offline manifest">
      <bpmn:incoming>Flow_ChecksDone</bpmn:incoming>
      <bpmn:outgoing>Flow_Precached</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_ConcertNight" name="Concert night">
      <bpmn:incoming>Flow_Precached</bpmn:incoming>
      <bpmn:outgoing>Flow_NightArrived</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_ConcertNight_timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_PlaySceneView" name="Play the set from the scene view, offline">
      <bpmn:incoming>Flow_NightArrived</bpmn:incoming>
      <bpmn:outgoing>Flow_SetPlayed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MarkBarPlayed" name="Move the bar to played in the CRM">
      <bpmn:incoming>Flow_SetPlayed</bpmn:incoming>
      <bpmn:outgoing>Flow_BarUpdated</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_ConcertPlayed" name="Concert played">
      <bpmn:incoming>Flow_BarUpdated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_FillSetlist" name="Fill the setlist, one pass per song">
      <bpmn:incoming>Flow_SetlistCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_SetlistFilled</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
      <bpmn:startEvent id="Event_SongChosen" name="Song chosen">
        <bpmn:outgoing>Flow_SongPicked</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_InCatalogue" name="Already in the catalogue?">
        <bpmn:incoming>Flow_SongPicked</bpmn:incoming>
        <bpmn:outgoing>Flow_SongKnown</bpmn:outgoing>
        <bpmn:outgoing>Flow_SongMissing</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_CreateSongIdea" name="Create the song as an idea">
        <bpmn:incoming>Flow_SongMissing</bpmn:incoming>
        <bpmn:outgoing>Flow_SongDrafted</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_SearchMusicbrainz" name="Search MusicBrainz from the song form">
        <bpmn:incoming>Flow_SongDrafted</bpmn:incoming>
        <bpmn:outgoing>Flow_Searched</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_MatchFound" name="Match found?">
        <bpmn:incoming>Flow_Searched</bpmn:incoming>
        <bpmn:outgoing>Flow_MatchYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_MatchNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_ApplyEnrichment" name="Apply album, duration, ISRCs and tags">
        <bpmn:incoming>Flow_MatchYes</bpmn:incoming>
        <bpmn:outgoing>Flow_Enriched</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_JoinEnrichment">
        <bpmn:incoming>Flow_MatchNo</bpmn:incoming>
        <bpmn:incoming>Flow_Enriched</bpmn:incoming>
        <bpmn:outgoing>Flow_ToChartChoice</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_ChartForm" name="Chart form?">
        <bpmn:incoming>Flow_ToChartChoice</bpmn:incoming>
        <bpmn:outgoing>Flow_ChartChordpro</bpmn:outgoing>
        <bpmn:outgoing>Flow_ChartFile</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_PasteChordpro" name="Paste ChordPro, review the derived tonality">
        <bpmn:incoming>Flow_ChartChordpro</bpmn:incoming>
        <bpmn:outgoing>Flow_TonalityReviewed</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_RequestPresign" name="Request a presigned upload URL">
        <bpmn:incoming>Flow_ChartFile</bpmn:incoming>
        <bpmn:outgoing>Flow_Presigned</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_UploadChart" name="Upload the chart file to the bucket">
        <bpmn:incoming>Flow_Presigned</bpmn:incoming>
        <bpmn:outgoing>Flow_Uploaded</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_JoinChart">
        <bpmn:incoming>Flow_SongKnown</bpmn:incoming>
        <bpmn:incoming>Flow_Uploaded</bpmn:incoming>
        <bpmn:incoming>Flow_TonalityReviewed</bpmn:incoming>
        <bpmn:outgoing>Flow_ChartAttached</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_AppendEntry" name="Append the song to the setlist">
        <bpmn:incoming>Flow_ChartAttached</bpmn:incoming>
        <bpmn:outgoing>Flow_Appended</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_EntryAppended" name="Entry appended">
        <bpmn:incoming>Flow_Appended</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SongPicked" sourceRef="Event_SongChosen" targetRef="Gateway_InCatalogue" />
      <bpmn:sequenceFlow id="Flow_SongKnown" name="yes" sourceRef="Gateway_InCatalogue" targetRef="Gateway_JoinChart" />
      <bpmn:sequenceFlow id="Flow_SongMissing" name="no" sourceRef="Gateway_InCatalogue" targetRef="Task_CreateSongIdea" />
      <bpmn:sequenceFlow id="Flow_SongDrafted" sourceRef="Task_CreateSongIdea" targetRef="Task_SearchMusicbrainz" />
      <bpmn:sequenceFlow id="Flow_Searched" sourceRef="Task_SearchMusicbrainz" targetRef="Gateway_MatchFound" />
      <bpmn:sequenceFlow id="Flow_MatchYes" name="yes" sourceRef="Gateway_MatchFound" targetRef="Task_ApplyEnrichment" />
      <bpmn:sequenceFlow id="Flow_MatchNo" name="no" sourceRef="Gateway_MatchFound" targetRef="Gateway_JoinEnrichment" />
      <bpmn:sequenceFlow id="Flow_Enriched" sourceRef="Task_ApplyEnrichment" targetRef="Gateway_JoinEnrichment" />
      <bpmn:sequenceFlow id="Flow_ToChartChoice" sourceRef="Gateway_JoinEnrichment" targetRef="Gateway_ChartForm" />
      <bpmn:sequenceFlow id="Flow_ChartChordpro" name="ChordPro text" sourceRef="Gateway_ChartForm" targetRef="Task_PasteChordpro" />
      <bpmn:sequenceFlow id="Flow_ChartFile" name="PDF or image" sourceRef="Gateway_ChartForm" targetRef="Task_RequestPresign" />
      <bpmn:sequenceFlow id="Flow_Presigned" sourceRef="Task_RequestPresign" targetRef="Task_UploadChart" />
      <bpmn:sequenceFlow id="Flow_Uploaded" sourceRef="Task_UploadChart" targetRef="Gateway_JoinChart" />
      <bpmn:sequenceFlow id="Flow_TonalityReviewed" sourceRef="Task_PasteChordpro" targetRef="Gateway_JoinChart" />
      <bpmn:sequenceFlow id="Flow_ChartAttached" sourceRef="Gateway_JoinChart" targetRef="Task_AppendEntry" />
      <bpmn:sequenceFlow id="Flow_Appended" sourceRef="Task_AppendEntry" targetRef="Event_EntryAppended" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Event_ConcertBooked" targetRef="Task_OpenApp" />
    <bpmn:sequenceFlow id="Flow_ToCookieCheck" sourceRef="Task_OpenApp" targetRef="Gateway_CookieValid" />
    <bpmn:sequenceFlow id="Flow_CookieYes" name="yes" sourceRef="Gateway_CookieValid" targetRef="Gateway_JoinSignedIn" />
    <bpmn:sequenceFlow id="Flow_CookieNo" name="no" sourceRef="Gateway_CookieValid" targetRef="Gateway_JoinLoginAttempt" />
    <bpmn:sequenceFlow id="Flow_TryPassword" sourceRef="Gateway_JoinLoginAttempt" targetRef="Task_EnterPassword" />
    <bpmn:sequenceFlow id="Flow_SubmitPassword" sourceRef="Task_EnterPassword" targetRef="Gateway_PasswordOutcome" />
    <bpmn:sequenceFlow id="Flow_Accepted" name="accepted" sourceRef="Gateway_PasswordOutcome" targetRef="Gateway_JoinSignedIn" />
    <bpmn:sequenceFlow id="Flow_WrongPassword" name="wrong password" sourceRef="Gateway_PasswordOutcome" targetRef="Gateway_JoinLoginAttempt" />
    <bpmn:sequenceFlow id="Flow_RateLimited" name="rate limited" sourceRef="Gateway_PasswordOutcome" targetRef="Event_RateLimitWindow" />
    <bpmn:sequenceFlow id="Flow_WindowElapsed" sourceRef="Event_RateLimitWindow" targetRef="Gateway_JoinLoginAttempt" />
    <bpmn:sequenceFlow id="Flow_SignedIn" sourceRef="Gateway_JoinSignedIn" targetRef="Task_CreateConcert" />
    <bpmn:sequenceFlow id="Flow_ConcertCreated" sourceRef="Task_CreateConcert" targetRef="Task_CreateSetlist" />
    <bpmn:sequenceFlow id="Flow_SetlistCreated" sourceRef="Task_CreateSetlist" targetRef="SubProcess_FillSetlist" />
    <bpmn:sequenceFlow id="Flow_SetlistFilled" sourceRef="SubProcess_FillSetlist" targetRef="Gateway_JoinReorder" />
    <bpmn:sequenceFlow id="Flow_ToReorder" sourceRef="Gateway_JoinReorder" targetRef="Task_ReorderEntries" />
    <bpmn:sequenceFlow id="Flow_StaleCaught" sourceRef="Event_ReorderStale" targetRef="Task_ReloadEntries" />
    <bpmn:sequenceFlow id="Flow_RetryReorder" sourceRef="Task_ReloadEntries" targetRef="Gateway_JoinReorder" />
    <bpmn:sequenceFlow id="Flow_OrderSaved" sourceRef="Task_ReorderEntries" targetRef="Gateway_ForkChecks" />
    <bpmn:sequenceFlow id="Flow_ForkTransitions" sourceRef="Gateway_ForkChecks" targetRef="Task_ReviewTransitions" />
    <bpmn:sequenceFlow id="Flow_ForkMastery" sourceRef="Gateway_ForkChecks" targetRef="Task_CheckMastery" />
    <bpmn:sequenceFlow id="Flow_TransitionsReviewed" sourceRef="Task_ReviewTransitions" targetRef="Gateway_TransitionsCovered" />
    <bpmn:sequenceFlow id="Flow_AllCovered" name="covered" sourceRef="Gateway_TransitionsCovered" targetRef="Gateway_JoinTransitions" />
    <bpmn:sequenceFlow id="Flow_RiskyGap" name="risky gap" sourceRef="Gateway_TransitionsCovered" targetRef="Task_FixRiskyGap" />
    <bpmn:sequenceFlow id="Flow_GapHandled" sourceRef="Task_FixRiskyGap" targetRef="Gateway_JoinTransitions" />
    <bpmn:sequenceFlow id="Flow_TransitionsDone" sourceRef="Gateway_JoinTransitions" targetRef="Gateway_JoinChecks" />
    <bpmn:sequenceFlow id="Flow_MasteryChecked" sourceRef="Task_CheckMastery" targetRef="Gateway_MasteryAbovePar" />
    <bpmn:sequenceFlow id="Flow_MasteryFine" name="yes" sourceRef="Gateway_MasteryAbovePar" targetRef="Gateway_JoinMastery" />
    <bpmn:sequenceFlow id="Flow_WeakSpot" name="weak spot" sourceRef="Gateway_MasteryAbovePar" targetRef="Task_SchedulePractice" />
    <bpmn:sequenceFlow id="Flow_PracticePlanned" sourceRef="Task_SchedulePractice" targetRef="Gateway_JoinMastery" />
    <bpmn:sequenceFlow id="Flow_MasteryDone" sourceRef="Gateway_JoinMastery" targetRef="Gateway_JoinChecks" />
    <bpmn:sequenceFlow id="Flow_ChecksDone" sourceRef="Gateway_JoinChecks" targetRef="Task_PrecacheManifest" />
    <bpmn:sequenceFlow id="Flow_Precached" sourceRef="Task_PrecacheManifest" targetRef="Event_ConcertNight" />
    <bpmn:sequenceFlow id="Flow_NightArrived" sourceRef="Event_ConcertNight" targetRef="Task_PlaySceneView" />
    <bpmn:sequenceFlow id="Flow_SetPlayed" sourceRef="Task_PlaySceneView" targetRef="Task_MarkBarPlayed" />
    <bpmn:sequenceFlow id="Flow_BarUpdated" sourceRef="Task_MarkBarPlayed" targetRef="Event_ConcertPlayed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PrepareConcert">
    <bpmndi:BPMNPlane id="BPMNPlane_PrepareConcert" bpmnElement="Collaboration_PrepareConcert">
      <bpmndi:BPMNShape id="Participant_Member_di" bpmnElement="Participant_Member" isHorizontal="true">
        <dc:Bounds x="160" y="100" width="4070" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Api_di" bpmnElement="Participant_Api" isHorizontal="true">
        <dc:Bounds x="160" y="840" width="4070" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Musicbrainz_di" bpmnElement="Participant_Musicbrainz" isHorizontal="true">
        <dc:Bounds x="1460" y="980" width="300" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_ChartsBucket_di" bpmnElement="Participant_ChartsBucket" isHorizontal="true">
        <dc:Bounds x="2120" y="0" width="300" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_FillSetlist_di" bpmnElement="SubProcess_FillSetlist" isExpanded="true">
        <dc:Bounds x="1180" y="140" width="1420" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ConcertBooked_di" bpmnElement="Event_ConcertBooked">
        <dc:Bounds x="212" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="192" y="285" width="68" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenApp_di" bpmnElement="Task_OpenApp">
        <dc:Bounds x="265" y="220" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CookieValid_di" bpmnElement="Gateway_CookieValid" isMarkerVisible="true">
        <dc:Bounds x="445" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="214" width="144" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinLoginAttempt_di" bpmnElement="Gateway_JoinLoginAttempt" isMarkerVisible="true">
        <dc:Bounds x="445" y="308" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterPassword_di" bpmnElement="Task_EnterPassword">
        <dc:Bounds x="405" y="380" width="130" height="80" />
