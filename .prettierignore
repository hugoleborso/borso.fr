# drizzle-kit owns these snapshots. Reformatting them desynchronises the
# regeneration round-trip and breaks knip's resolution graph.
apps/*/api/src/database/migrations/meta

# Vitest owns its file snapshots. It writes the string the test hands it, so a
# Prettier pass (which collapses short JSON arrays onto one line) makes the very
# next run report a mismatch against a file Prettier just rewrote.
**/__snapshots__/

