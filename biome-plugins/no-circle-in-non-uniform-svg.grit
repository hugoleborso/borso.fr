// Forbid round SVG markers (`<circle>` / `<ellipse>`) inside an `<svg>`
// that sets `preserveAspectRatio="none"`. A non-uniform-scaled viewBox
// stretches the X and Y axes by different factors, so a circle renders
// as a horizontally-squashed ellipse on any container whose aspect ratio
// differs from the viewBox. The smooth `<path>` of a sparkline is fine
// to stretch; its point markers are not.
//
// First hit (twice) in PR #31's energy sparkline — and the trap was
// already documented in
// docs/knowledge/svg-preserveaspectratio-distorts-non-uniform.md, which
// a knowledge entry alone failed to prevent. Eradicated here as a lint.
// See docs/dantotsus/circle-went-oval-in-a-stretched-svg-again.md.
//
// Fix: keep the stretched `<path>`/area in the SVG, render the round
// markers as CSS-positioned `rounded-full` elements over it (`left` as a
// % from the data, `top` in px since the vertical axis stays 1:1).

engine biome(1.0)
language js(jsx)

`<svg $props>$children</svg>` where {
  $props <: contains `preserveAspectRatio="none"`,
  $children <: contains or { `<circle $_ />`, `<ellipse $_ />`, `<circle $_></circle>`, `<ellipse $_></ellipse>` },
  register_diagnostic(
    span = $children,
    message = "Round markers (`<circle>`/`<ellipse>`) in an `<svg preserveAspectRatio=\"none\">` render as ovals — non-uniform scaling stretches X and Y differently. Keep the stretched path in the SVG and overlay the dots as CSS `rounded-full` elements. See docs/knowledge/svg-preserveaspectratio-distorts-non-uniform.md.",
    severity = "error"
  )
}
