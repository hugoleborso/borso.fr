{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pretool-gh-pr-create.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pretool-no-broad-kill.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pretool-no-swallowed-push.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pretool-no-discarding-reset.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pretool-github-pr-body.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pretool-blueprint-context.sh",
            "statusMessage": "Seeding the layer's blueprint"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/posttool-format-write.sh",
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
