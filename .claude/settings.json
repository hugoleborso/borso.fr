{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "permissions": {
    "allow": ["Bash(scripts/db-read.sh *)", "Bash(pnpm run db:read *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${TMPDIR:-/tmp}/borso-hook-compile-cache\" node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Skill|Agent|Task|Artifact|mcp__github__merge_pull_request|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__claude-code-remote__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${TMPDIR:-/tmp}/borso-hook-compile-cache\" node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|ReadNotifications|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${TMPDIR:-/tmp}/borso-hook-compile-cache\" node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/hook.ts"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${TMPDIR:-/tmp}/borso-hook-compile-cache\" node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${TMPDIR:-/tmp}/borso-hook-compile-cache\" node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/hook.ts"
          }
        ]
      }
    ]
  }
}
