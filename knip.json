{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "ignoreBinaries": ["typecheck", "build"],
      "ignoreDependencies": [
        "@stryker-mutator/core",
        "@stryker-mutator/vitest-runner",
        "@swmansion/argent",
        "agent-browser",
        "esbuild"
      ],
      "entry": [
        ".claude/skills/blueprint/blueprint-*.ts",
        "scripts/architecture/*.ts",
        "scripts/blueprints/blueprint-defects.ts",
        "scripts/standards/enforcement-ledger.ts",
        "scripts/standards/seal.ts",
        "scripts/**/*.test.ts"
      ],
      "project": [".claude/skills/blueprint/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/borso-fr": {
      "entry": [
        "bin/app.ts",
        "site/src/art/mondrian/main.tsx",
        "site/src/12-travaux/main.tsx",
        "site/**/*.utils.test.ts"
      ],
      "project": ["bin/**/*.ts", "site/**/*.ts", "site/**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/borsouvertures": {
      "entry": ["bin/app.ts", "site/**/*.utils.test.ts"],
      "project": ["bin/**/*.ts", "scripts/**/*.ts", "site/**/*.ts", "site/**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/last-loop-lepin": {
      "entry": [
        "cdk/bin/cdk.ts",
        "api/src/main.ts",
        "api/src/**/*.test.ts",
        "site/src/**/*.utils.test.ts",
        "test/**/*.ts"
      ],
      "project": [
        "cdk/**/*.ts",
        "site/src/**/*.ts",
        "site/src/**/*.tsx",
        "api/src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/pragma": {
      "entry": [
        "cdk/bin/cdk.ts",
        "api/src/main.ts",
        "api/src/**/*.test.ts",
        "domain/**/*.core.test.ts",
        "site/src/**/*.utils.test.ts",
        "site/src/**/*.core.test.ts",
        "test/**/*.ts"
      ],
      "project": [
        "cdk/**/*.ts",
        "domain/**/*.ts",
        "site/src/**/*.ts",
        "site/src/**/*.tsx",
        "api/src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": ["tailwindcss"]
    },
    "infra/cdk": {
      "entry": [
        "src/index.ts",
        "src/internal/migration-runner/index.ts",
        "src/internal/cf-host-routing-function.code.js",
        "src/internal/cf-static-site-index-rewrite.code.js",
        "test/**/*.test.ts",
        "test/unit/fixtures/handler.ts"
      ],
      "ignoreDependencies": ["esbuild"]
    },
    "infra/shared": {
      "entry": ["bin/shared.ts", "test/unit/**/*.test.ts"],
      "project": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    }
  }
}
