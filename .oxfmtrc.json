{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "cdk.out",
    "coverage",
    "pnpm-lock.yaml",
    "apps/*/api/src/database/migrations/meta",
    "**/__snapshots__/",
    "apps/borsouvertures/site/src/openings/openings.json",
    "apps/borsouvertures/site/public/openings.json",
    "plugins/borso-harness/skills/plain-writing/SKILL.md",
    "plugins/borso-harness/skills/plain-writing/LICENSE",
    ".claude/skills/writing-great-skills/references/",
    ".claude/skills/impeccable/",
    ".claude/agents/impeccable-*.md",
    "**/*.md",
    ".claude/skills/blueprint/blueprint-coverage.html",
    "docs/architecture/*-architecture.html",
    "docs/architecture/*-architecture.json",
    "docs/architecture/index.html"
  ]
}
