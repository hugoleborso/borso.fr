set -e

# Pre-commit holds the checks a single commit can break, each run only when the
# commit touches something it reads. Per-file checks get the staged files as
# arguments; whole-tree checks run only when the commit touches their scope.
# Anything slower moves to .husky/pre-push or ci.yml. See
# docs/standards/14-tool-runtime-budgets.md.

# Every path the commit adds, changes or removes, one per line as
# `<status> <path>`, with a rename split into the removal of its old path and
# the addition of its new one. A rename or a deletion breaks what names the old
# path, so checks that resolve names scope on `^D `.
touched=$(git diff --cached --name-status --no-renames | sed -E 's/^([A-Z])[0-9]*\t/\1 /')
touched_paths=$(printf '%s\n' "$touched" | sed -E 's/^[A-Z] //')
path_lines="
$touched_paths
"

results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT

# The checks run side by side, two per core, because none of them writes
# anything another reads. The longest ones set the commit's wall time, so every
# other check runs at a lower priority and yields the CPU to them. Each check's
# output is held back and printed in the order below once all have finished,
# so a failure reads the same as it would if they ran one after another.
cores=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
max_parallel=$((cores * 2))
LONGEST_CHECKS='oxlint typecheck-tooling node-checks'
SHORT_CHECK_NICENESS=10
running=''
launched=0

count_running() {
  set -- $running
  running_count=$#
}

# Reaps every check that has finished, whichever they are, so a slow check
# started early does not hold a free core behind it. Each running check is one
# `<pid>:<slot>` word, and a check has finished once its slot has a result.
reap_finished() {
  still_running=''
  for entry in $running; do
    if [ -f "${entry#*:}.result" ]; then
      wait "${entry%%:*}" || true
    else
      still_running="$still_running $entry"
    fi
  done
  running="$still_running"
}

# launch <name> <command…>: starts one check in the background.
launch() {
  name="$1"
  shift
  launched=$((launched + 1))
  slot="$results/$(printf '%03d' "$launched")"
  printf '%s\n' "$name" >"$slot.check"
  count_running
  while [ "$running_count" -ge "$max_parallel" ]; do
    reap_finished
    count_running
    [ "$running_count" -ge "$max_parallel" ] && sleep 0.05
  done
  (
    case " $LONGEST_CHECKS " in
      *" $name "*) ;;
      *) renice -n "$SHORT_CHECK_NICENESS" -p "$(sh -c 'echo $PPID')" >/dev/null 2>&1 || true ;;
    esac
    if "$@" >"$slot.out" 2>&1; then status=0; else status=$?; fi
    echo "$status" >"$slot.result"
  ) &
  running="$running $!:$slot"
}

# Whether the commit touches what a check reads: its scope, matched against the
# `<status> <path>` lines, or a file its own command line names, so that editing
# a check runs it.
is_in_scope() {
  scope="$1"
  shift
  if printf '%s\n' "$touched" | grep -qE "$scope"; then
    return 0
  fi
  for word in "$@"; do
    case "$path_lines" in
      *"
$word
"*) return 0 ;;
    esac
  done
  return 1
}

# run_check <name> <scope> <command…>: a whole-tree check, run when the commit
# touches its scope.
run_check() {
  name="$1"
  scope="$2"
  shift 2
  is_in_scope "$scope" "$@" || return 0
  launch "$name" "$@"
}

# run_check_on_files <name> <path pattern> <command…>: a per-file check, handed
# the touched paths that match as arguments.
run_check_on_files() {
  name="$1"
  pattern="$2"
  shift 2
  run_with_files "$name" "$pattern" run_on_subjects "$@"
}

run_with_files() {
  name="$1"
  pattern="$2"
  shift 2
  subjects=$(printf '%s\n' "$touched_paths" | grep -E "$pattern" || true)
  [ -n "$subjects" ] || return 0
  launch "$name" "$@"
}

run_on_subjects() {
  printf '%s\n' "$subjects" | tr '\n' '\0' | xargs -0 "$@"
}

# The staged files that still exist, NUL-separated, for the tools that take
# paths: a staged deletion is a path no formatter or linter can open.
list_existing_subjects() {
  printf '%s\n' "$subjects" | while IFS= read -r candidate; do
    [ -f "$candidate" ] && printf '%s\0' "$candidate"
  done
}

run_oxfmt() {
  list_existing_subjects | xargs -0 --no-run-if-empty node_modules/.bin/oxfmt --check
}

run_oxlint() {
  list_existing_subjects | xargs -0 --no-run-if-empty scripts/lint-staged-files.sh
}

# queue_node_check <name> <scope> <script…>: a check written in TypeScript,
# queued when the commit touches its scope. The queued checks then run in one
# node process, scripts/standards/run-node-checks.ts, which imports each in turn
# with its own arguments, so node and the TypeScript resolver load once.
node_check_jobs=''
node_check_count=0
queue_node_check() {
  name="$1"
  scope="$2"
  shift 2
  is_in_scope "$scope" "$1" || return 0
  node_check_jobs="${node_check_jobs}${name}=$*
"
  node_check_count=$((node_check_count + 1))
}

run_node_checks() {
  IFS='
'
  set -f
  # shellcheck disable=SC2086
  node --import ./scripts/typescript-resolve.mjs scripts/standards/run-node-checks.ts $node_check_jobs
}

launch_node_checks() {
  [ "$node_check_count" -gt 0 ] || return 0
  launch node-checks run_node_checks
}

# oxfmt over the staged files.
run_with_files oxfmt '\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|css|ya?ml|html)$' run_oxfmt

# oxlint over the staged files with every rule, the type-aware ones and the
# unused-directive report included, through scripts/lint-staged-files.sh,
# which builds a TypeScript program of the staged files only. Warnings fail it:
# `denyWarnings` is set in .oxlintrc.json. Rung-1 eradication, together with
# the push and CI runs, of docs/dantotsus/biome-lint-was-not-gated-anywhere.md.
run_with_files oxlint '\.(js|jsx|ts|tsx|mjs|cjs)$' run_oxlint

# The repository's own tooling, type-checked with TypeScript 7: `scripts/`,
# `.claude/skills/` and `eslint-rules/` belong to no workspace, so
# `pnpm -r typecheck` never reaches them and `tsx` strips types without reading
# them. `--singleThreaded` leaves the other cores to the checks running beside
# it. See
# docs/dantotsus/the-tooling-that-gates-everything-was-checked-by-nothing.md.
if is_in_scope '^. ((scripts|\.claude/skills)/.*\.(ts|mts|js|mjs)|eslint-rules/.*\.js|tsconfig\.json)$'; then
  launch typecheck-tooling node_modules/.bin/tsc -p tsconfig.json --noEmit --singleThreaded
fi

# Blueprint annotations and the convention baseline, whenever source changed.
# Each refuses something a person did: an annotation naming no blueprint, a
# question the tree had already answered being answered a second way.
blueprint_scope='^. ([^ ]*\.(js|jsx|ts|tsx|mjs|cjs)|\.claude/skills/blueprint/.*)$'
queue_node_check blueprint-index "$blueprint_scope" \
  .claude/skills/blueprint/blueprint-indexing.ts --check
queue_node_check convention-drift "$blueprint_scope" \
  scripts/standards/convention-drift.ts --check

# The dantotsu record's front matter. See
# docs/adr/0029-weak-point-management-from-the-dantotsu-record.md.
queue_node_check dantotsu-front-matter '^. (docs/dantotsus/|scripts/quality/)|^D ' \
  scripts/quality/check-dantotsu-front-matter.ts --staged

# One version per dependency lives in pnpm-workspace.yaml.
queue_node_check dependency-catalog '^. ((.*/)?package\.json|pnpm-workspace\.yaml)$' \
  scripts/dependencies/check-dependency-catalog.ts

# The template a PR body is drafted from fits the budget the same script
# enforces on the body.
queue_node_check pr-body-template '^. (plugins/borso-harness/skills/open-pr/template\.md|scripts/pr/)' \
  scripts/pr/check-pr-body.ts plugins/borso-harness/skills/open-pr/template.md

# A document that links a file which is not there. `--staged` reads the staged
# documents and every document naming a path the commit removes; a link to a
# generated, gitignored report is judged in ci.yml, after the generators run,
# because a checkout that never ran them has nothing to judge it against. See
# docs/dantotsus/the-hook-checked-links-to-files-it-declined-to-build.md.
queue_node_check doc-links '\.md$|^D ' scripts/docs/check-doc-links.ts --staged

launch_node_checks

# DSQL compatibility of staged migration SQL. Rung-2 eradication of
# docs/dantotsus/dsql-alter-table-only-add-column.md.
run_check_on_files migration-sql 'api/src/database/migrations/.*\.sql$' \
  scripts/check-migration-sql-dsql-compat.sh

# One stylesheet per application, holding tokens only, with no comment in it or
# in a page. A second CSS file is how an application drifts back to global class
# names; `borso/no-comments` is a lint rule and oxlint lints no `.css` and no
# `.html` here.
run_check single-stylesheet '\.css$' scripts/check-single-stylesheet.sh
run_check stylesheet-contents '\.css$' scripts/check-stylesheet-contents.sh
run_check no-comments-in-styles-and-markup '\.(css|html)$' \
  scripts/check-no-comments-in-styles-and-markup.sh

# No Tailwind arbitrary variant opens on a bare word, which Tailwind reads as an
# attribute selector and compiles to nothing at all.
run_check tailwind-arbitrary-variants '^. apps/[^/]+/site/' \
  scripts/check-tailwind-arbitrary-variants.sh

# Every directory under apps/ has a path-filters key and a commitlint scope.
# No filter means the app never gets a preview deploy; no scope means the first
# commit naming the app is rejected by a hook talking about an enum.
run_check app-registration \
  '^. (apps/[^/]+/(package\.json|bin/|cdk/|api/src/database/migrations/)|\.github/path-filters\.yml$|commitlint\.config\.js$)' \
  scripts/check-app-registration.sh

# Each term in an application's vocabulary names the folder that owns it and
# the test that holds it, and those get renamed or removed by changes with no
# reason to open the vocabulary. An edited test matters only when a `Held by`
# line names it, since the check reads its titles; any other test edit left
# the check reading files it could not have changed.
held_tests=$(
  awk 'FNR == 1 { folder = FILENAME; sub(/VOCABULARY\.md$/, "", folder) }
    /^Held by: `/ { cited = $0; sub(/^Held by: `/, "", cited); sub(/`.*/, "", cited)
      gsub(/\./, "\\.", cited); print folder cited }' apps/*/VOCABULARY.md 2>/dev/null |
    sort -u | paste -sd '|' -
)
run_check vocabulary-paths \
  "^. apps/[^/]+/VOCABULARY\\.md\$|^D apps/${held_tests:+|^M (${held_tests})\$}" \
  scripts/check-vocabulary-paths.sh

# A dated record of a past review is not editable: it is true as of the day in
# its own file name. Reads the staged edits only.
run_check dated-records '^. docs/' scripts/check-dated-records-are-append-only.sh

# A NUL byte turns a source file into a binary as far as git is concerned.
# Every staged file, and nothing else; ci.yml reads the whole tree.
run_check_on_files no-null-bytes '.' scripts/check-no-null-bytes.sh

# A dependency bump can rewrite a script into a version. The one version per
# dependency in pnpm-workspace.yaml is checked with the node checks above.
run_check_on_files package-scripts-are-commands 'package\.json$' \
  scripts/check-package-scripts-are-commands.sh

# A `VITE_*` variable a site reads and no workflow sets is a feature that never
# runs. Rung-2 eradication of
# docs/dantotsus/a-feature-that-was-never-switched-on-in-any-stage.md.
run_check frontend-env-vars '^. (apps/[^/]+/site/|\.github/workflows/)' \
  scripts/check-frontend-env-vars.sh

# A manifest naming an icon that is not there installs a grey square. Only the
# applications whose site the commit touches.
run_check_on_files pwa-assets '^apps/[^/]+/site/' scripts/check-pwa-assets.sh

# A knowledge entry saying a tool is broken carries a date, and every entry
# declares the moment a hook delivers it. See
# docs/adr/0030-knowledge-is-delivered-by-trigger.md.
run_check_on_files negative-claims-are-dated '^docs/knowledge/.*\.md$' \
  scripts/check-negative-claims-are-dated.sh
run_check knowledge-triggers '^. docs/knowledge/' scripts/check-knowledge-triggers.sh

# A pure module whose only consumer is its own test scores 100% on coverage and
# mutation while running nowhere. Rung-2 eradication of
# docs/dantotsus/three-green-gates-on-code-that-ran-nowhere.md.
run_check pure-modules-have-callers '^. (apps|infra)/.*\.tsx?$' \
  scripts/check-pure-modules-have-callers.sh

# A non-module <script src> tag ships un-bundled and 404s. Rung-2 eradication of
# docs/dantotsus/vite-non-module-script-tags-arent-bundled.md.
run_check non-module-scripts '^. apps/[^/]+/site/.*\.html$' scripts/check-non-module-scripts.sh

# A directory walk piped into `head` or `grep -q` is a race under pipefail.
run_check_on_files no-racy-pipelines '(\.sh$|^\.husky/)' scripts/check-no-racy-pipelines.sh

# The harness lives once, in plugins/borso-harness/, and reaches a session only
# through the links in .claude/ and the hook entries in .claude/settings.json.
run_check harness-links '^. (plugins/borso-harness/|\.claude/)' scripts/check-harness-links.sh

# Two lists that have to say the same thing. Rung-2 eradication of
# docs/dantotsus/two-copies-that-had-to-agree-and-nothing-made-them.md.
run_check coupled-lists \
  '^. (docs/knowledge/|eslint-rules/impurity\.js$|apps/[^/]+/vitest\.config\.ts$|apps/[^/]+/api/src/database/migrations/|apps/[^/]+/test/(setup-postgres|database-utils)\.ts$|apps/pragma/cdk/lib/stack\.ts$|docs/adr/0009-|scripts/check-coupled-lists\.sh$)' \
  scripts/check-coupled-lists.sh

# Each number in a sequence is claimed once, and an ADR's heading, filename and
# index row agree. See
# docs/dantotsus/an-adr-number-goes-to-whoever-writes-it-first.md.
run_check numbered-sequences '^. (apps/[^/]+/api/src/database/migrations/|docs/adr/)' \
  scripts/check-numbered-sequences.sh
run_check adr-numbers-resolve '^. docs/adr/' scripts/check-adr-numbers-resolve.sh

# No instruction surface tells an agent to run a command this repository does
# not have, and no path one names is missing. Rung-2 eradications of
# docs/dantotsus/the-skill-that-named-the-linter-the-repository-deleted.md and
# docs/dantotsus/the-link-checker-skipped-the-folder-it-was-trusted-for.md.
run_check_on_files instructions-name-installed-tools \
  '^(\.claude/|plugins/|docs/standards/|docs/features/[^/]+/[^/]+/(plan|spec)/).*\.(md|sh)$' \
  scripts/check-instructions-name-installed-tools.sh
if is_in_scope '^. (scripts/|\.husky/|\.github/|plugins/|\.claude/|CLAUDE\.md$)|^D '; then
  run_with_files named-paths-exist '.' scripts/check-named-paths-exist.sh --staged
fi

# `deploy`, `destroy`, `install`, `update`, `sync`, `fetch` and `publish` are
# pnpm built-ins; without `run`, pnpm shadows the package's script. Rung-2
# eradication of docs/dantotsus/pnpm-reserved-script-names.md.
check_pnpm_reserved_names() {
  PNPM_RESERVED_REGEX='pnpm[[:space:]]+--filter[[:space:]]+("[^"]+"|[^[:space:]]+)[[:space:]]+(deploy|destroy|install|update|sync|fetch|publish)([[:space:]]|$)'
  if grep -nrE "$PNPM_RESERVED_REGEX" .github/workflows/ >&2; then
    echo "[pre-commit] ERROR: above lines invoke a pnpm built-in instead of a package script." >&2
    echo "[pre-commit] Use 'pnpm --filter <pkg> run <name>' to force script lookup." >&2
    return 1
  fi
}
run_check pnpm-reserved-names '^. \.github/workflows/' check_pnpm_reserved_names

for entry in $running; do
  wait "${entry%%:*}" || true
done

failed=''
for check in "$results"/*.check; do
  [ -f "$check" ] || continue
  slot="${check%.check}"
  cat "$slot.out"
  read -r status <"$slot.result"
  if [ "$status" -ne 0 ]; then
    failed="${failed} $(sed -n 1p "$check")"
  fi
done

if [ -n "$failed" ]; then
  echo "[pre-commit] ERROR: these checks refused the commit; each printed its reason above:${failed}" >&2
  exit 1
fi
