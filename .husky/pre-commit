set -e

# Pre-commit holds only checks that are cheap and that should be true of every
# single commit, so committing stays fast enough that nobody reaches for
# --no-verify. Anything that needs the whole branch in view, or that takes more
# than a second or two, lives in .husky/pre-push instead.
#
# The split, so the next person editing these files keeps it:
#
#   pre-commit  a per-file invariant, cheap, and true of every commit
#   pre-push    needs the branch in view, or costs real time

changed=$(git diff --cached --name-only --diff-filter=ACMR)

# ESLint and Prettier over the STAGED files only. Linting the whole repository
# here would not be a small check: the type-aware rules build a TypeScript
# program per workspace, so a cold full run is about 80 s, and a branch that
# touches many files thrashes the cache and pays most of that on every commit.
#
# Whole-repository linting still happens, in ci.yml, where it also catches the
# cross-file rules that a staged-file run cannot see, e.g. import-x/no-cycle.
# So the commit gate is fast and local, and the branch gate is exhaustive.
#
# Rung-1 eradication, together with the ci.yml backup, of
# docs/dantotsus/biome-lint-was-not-gated-anywhere.md.
#
# --max-warnings 0 is what makes the warning-severity rules a gate. Several
# rules the standards rely on ship at `warn` from their plugin's recommended
# preset — react-hooks/exhaustive-deps, react-hooks/incompatible-library — and
# eslint exits 0 on a warning, so without this flag those rules printed and
# nothing stopped. A warning nobody has to clear is a rule that is off.
staged_lintable=$(echo "$changed" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs)$' || true)
if [ -n "$staged_lintable" ]; then
  echo "[pre-commit] running eslint on staged files"
  echo "$staged_lintable" | xargs pnpm exec eslint --no-warn-ignored --max-warnings 0 --cache --cache-strategy content --cache-location .eslintcache
fi

staged_formattable=$(echo "$changed" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|css|ya?ml|html)$' || true)
if [ -n "$staged_formattable" ]; then
  echo "[pre-commit] running prettier on staged files"
  echo "$staged_formattable" | xargs node_modules/.bin/prettier --check --cache --ignore-unknown
fi

# DSQL compatibility of staged migration SQL. The find inside is a no-op when
# no migration is staged, so unrelated work is not slowed down. Rung-2
# eradication of docs/dantotsus/dsql-alter-table-only-add-column.md.
if echo "$changed" | grep -q 'api/src/database/migrations/.*\.sql$'; then
  echo "[pre-commit] migration SQL changed — running DSQL-compat check"
  ./scripts/check-migration-sql-dsql-compat.sh
fi

# Blueprint annotations, whenever source changed. A `@Blueprint` missing a tag
# still lands in the index with an empty cell, and a `// @FollowsBlueprint` that
# names nothing still reads as adoption, so neither fails anything on its own.
# The check also refuses a stale index, which is what stops an annotation from
# being added without the generated file catching up. One pass over the tree,
# well under a second, so it belongs on the commit.
#
# The three generated artefacts are checked together, and every stale one is
# named in a single rejection. Run under `set -e` as three consecutive
# commands, the first failure ended the hook, so a commit that moved all three
# was rejected three times and the operator learned about one generator per
# attempt. The cost of continuing is one more pass over a tree that is already
# in the file cache.
generator_failures=""
run_generator_check() {
  if ! pnpm exec tsx "$1" --check; then
    generator_failures="${generator_failures}  pnpm exec tsx $1
"
  fi
}

if [ -n "$staged_lintable" ]; then
  echo "[pre-commit] checking blueprint annotations"
  set +e
  run_generator_check .claude/skills/blueprint/blueprint-indexing.ts
  run_generator_check .claude/skills/blueprint/blueprint-heatmap.ts
  # The defect page and the seeding lookup are generated from the same
  # annotations, so they go stale on the same edit: a dantotsu naming a
  # blueprint that does not exist, and a hook seeding a pattern nobody carries
  # any more, both read as fine until someone follows them.
  run_generator_check scripts/blueprints/blueprint-defects.ts
  run_generator_check .claude/skills/blueprint/blueprint-context.ts
  # Two spellings for one idea. Gated on a baseline that only goes down, so the
  # existing backlog never blocks a commit and the next divergence does. A git
  # index read plus one pass over the tree, so it belongs on the commit.
  run_generator_check scripts/standards/convention-drift.ts
  # Which rules were written because something went wrong. A report; the check
  # refuses only a stale page, because a ratio between defect-born and
  # principle-born rules is not a thing to gate on.
  run_generator_check scripts/standards/rule-provenance.ts
  set -e
fi

# The architecture pages, whenever any application changed. The generator
# derives each graph from paths, imports and the Hono call chain, so a rename or
# a new route moves the page without anyone editing it, and a stale page is a
# diagram that lies. It also refuses a `@DependsOnExternal` naming an external
# system the manifest does not declare, and a declared external no file reaches,
# because either half alone is how a context diagram drifts from the code.
# The three paths are the ones .github/workflows/architecture.yml watches, and
# the two lists have to stay the same: a commit that changed only
# blueprint-utils.ts, whose layer table the generator reads, used to reach CI
# with a page nothing had regenerated.
if git diff --cached --name-only |
  grep -qE '^(apps/|scripts/architecture/|\.claude/skills/blueprint/blueprint-utils\.ts$)'; then
  echo "[pre-commit] checking the architecture pages"
  set +e
  run_generator_check scripts/architecture/architecture-graph.ts
  set -e
fi

if [ -n "$generator_failures" ]; then
  echo "[pre-commit] ERROR: generated files are stale. Run all of these, then commit again:" >&2
  printf '%s' "$generator_failures" >&2
  exit 1
fi

# One stylesheet per application. A second CSS file is how an application
# drifts back to global class names, because the first rule that does not fit a
# utility goes there and the rest follow. A git-index read of four directories,
# so it costs nothing and belongs on the commit.
echo "[pre-commit] checking each app ships one stylesheet"
scripts/check-single-stylesheet.sh

# And that the one stylesheet holds tokens only. Counting the files never opens
# one, so a global `.classname { … }` rule inside it — the cascade coming back,
# invisible in the JSX it styles — had no gate at all.
echo "[pre-commit] checking each stylesheet holds tokens only"
scripts/check-stylesheet-contents.sh

# Every directory under apps/ has a path-filters key and a commitlint scope.
# Both failures are silent in the way that matters: no filter means the app
# never gets a preview deploy and no workflow says so, and no scope means the
# first commit naming the app is rejected by a hook talking about an enum.
echo "[pre-commit] checking each app is registered"
scripts/check-app-registration.sh

# One version per dependency, written in pnpm-workspace.yaml. Nothing else here
# reads a version field, so two workspaces drifting onto different majors of the
# same library passes every other gate and surfaces later as a type error in
# whichever file sits across the seam.
# Each term in an application's vocabulary names the folder that owns it, and
# that folder gets renamed by changes with no reason to open the vocabulary.
echo "[pre-commit] checking each vocabulary term names a folder that exists"
scripts/check-vocabulary-paths.sh

echo "[pre-commit] checking no file carries a NUL byte"
scripts/check-no-null-bytes.sh

echo "[pre-commit] checking every shared dependency reads the catalog"
pnpm exec tsx scripts/dependencies/check-dependency-catalog.ts

# The enforcement ledger, whenever a standard or one of the mechanisms it can
# cite changed. It resolves every `## Enforced by` bullet against the live
# ESLint configuration and the checked-in hooks, so it fails on a rule cited
# and enabled nowhere, a script no hook invokes, a gate whose command is absent
# from a site it claims, and a mechanism that runs while no standard says why.
#
# This is the one check here that is not instant: it builds an ESLint instance
# and resolves a configuration per probe path, measured at 6.9 s. It stays on
# the commit because the trigger is narrow — the standards, the rules, the
# config and the two gate sites — and a commit touching those is rare, while a
# standard claiming an enforcement nobody runs is exactly what this branch
# found four of.
if git diff --cached --name-only |
  grep -qE '^(docs/standards/|eslint-rules/|eslint\.config\.js|\.husky/|\.github/workflows/)'; then
  echo "[pre-commit] checking the enforcement ledger"
  pnpm exec tsx scripts/standards/enforcement-ledger.ts --check
fi

# A `VITE_*` variable a site reads and no workflow sets is a feature that never
# runs, in every stage, silently: Vite substitutes `undefined` at build time and
# nothing fails. A git-index read plus a grep over the workflows, so it costs
# nothing and belongs on the commit. Rung-2 eradication of
# docs/dantotsus/a-feature-that-was-never-switched-on-in-any-stage.md.
echo "[pre-commit] checking each VITE_ variable a site reads is wired"
scripts/check-frontend-env-vars.sh

# A manifest naming an icon that is not there installs a grey square, and the
# build, the tests, the linter and the page all keep passing. A JSON parse plus
# a handful of stat calls, so it costs nothing and belongs on the commit.
echo "[pre-commit] checking each manifest names icons that ship"
scripts/check-pwa-assets.sh

# A knowledge entry saying a tool is broken steers every future agent away from
# it and never expires on its own — two phone audits obeyed one that was wrong.
# A grep over one directory, so it costs nothing and belongs on the commit.
echo "[pre-commit] checking every \"does not work\" carries a date"
scripts/check-negative-claims-are-dated.sh

# A document that links a file which is not there sends the reader looking for a
# stale document rather than a stale link. The routing table in
# `/code-standards` carried thirteen of them, one `../` short of the repository
# root, which a rendered preview cannot show.
echo "[pre-commit] checking every document link names a file that exists"
pnpm exec tsx scripts/docs/check-doc-links.ts

# A pure module whose only consumer is its own test scores 100% on the coverage
# and mutation gates while running nowhere, and knip cannot see it because every
# test file is a knip entry point. A git-index read plus a grep, so it costs
# nothing and belongs on the commit. Rung-2 eradication of
# docs/dantotsus/three-green-gates-on-code-that-ran-nowhere.md.
echo "[pre-commit] checking each pure module has a caller"
scripts/check-pure-modules-have-callers.sh

# A non-module <script src> tag ships un-bundled and 404s in preview and
# production. A grep over the app HTML, so it costs nothing and belongs on the
# commit rather than the push. Rung-2 eradication of
# docs/dantotsus/vite-non-module-script-tags-arent-bundled.md.
echo "[pre-commit] checking app HTML for non-module <script src> tags"
scripts/check-non-module-scripts.sh

# Two lists that have to say the same thing. Both halves read correctly alone
# and only the pair is wrong, which is why review never caught either of the two
# that shipped in PR #49. Rung-2 eradication of
# docs/dantotsus/two-copies-that-had-to-agree-and-nothing-made-them.md.
echo "[pre-commit] checking the lists that have to agree"
scripts/check-coupled-lists.sh

# A workspace with gated files and no mutation config reports nothing, not zero,
# and a coverage number then reads as reassurance it has not earned. Rung-2
# eradication of docs/dantotsus/the-gate-that-was-never-pointed-at-the-code.md.
echo "[pre-commit] checking every gated workspace is mutated"
scripts/check-mutation-covers-gated-files.sh

# `deploy`, `destroy`, `install`, `update`, `sync`, `fetch` and `publish` are
# pnpm built-ins. Without `run`, pnpm shadows the package's scripts entry and
# silently does the wrong thing. Another instant grep of a standing invariant.
# Rung-2 eradication of docs/dantotsus/pnpm-reserved-script-names.md.
echo "[pre-commit] checking workflows for pnpm reserved-name shadowing"
PNPM_RESERVED_REGEX='pnpm[[:space:]]+--filter[[:space:]]+("[^"]+"|[^[:space:]]+)[[:space:]]+(deploy|destroy|install|update|sync|fetch|publish)([[:space:]]|$)'
if grep -nrE "$PNPM_RESERVED_REGEX" .github/workflows/ >&2; then
  echo "[pre-commit] ERROR: above lines invoke a pnpm built-in instead of a package script." >&2
  echo "[pre-commit] Use 'pnpm --filter <pkg> run <name>' to force script lookup." >&2
  exit 1
fi
