set -e

# Repo-wide ESLint + Prettier check at every commit. Runs at root scope so it
# covers files outside any pnpm workspace, e.g. scripts/ and eslint-rules/,
# complementing the per-workspace `pnpm -r lint` step in ci.yml.
#
# Rung-1 eradication, together with the ci.yml backup, of
# docs/dantotsus/biome-lint-was-not-gated-anywhere.md. The defect class cannot
# land in main, because pre-commit rejects the introducing commit and CI
# rejects the pull request when someone bypasses the hook.
#
# `--max-warnings 0` is deliberately absent while the react-hooks warnings
# inherited from the biome era are still being cleared. The errors gate is
# hard, and eslint-suppressions.json is the inventory of what is left.
echo "[pre-commit] running eslint"
pnpm exec eslint . --cache --cache-location .eslintcache

echo "[pre-commit] running prettier"
pnpm exec prettier --check . --cache

# Run the relevant @borso/* infra package's full test suite (including 100%
# coverage thresholds) whenever a commit touches its source. Cheap to skip
# when nothing under infra/ changed.
changed=$(git diff --cached --name-only --diff-filter=ACMR)

if echo "$changed" | grep -q '^infra/cdk/'; then
  echo "[pre-commit] infra/cdk/ changed — running @borso/infra test:coverage"
  pnpm --filter @borso/infra test:coverage
fi

if echo "$changed" | grep -q '^infra/shared/'; then
  echo "[pre-commit] infra/shared/ changed — running @borso/shared-infra test:coverage"
  pnpm --filter @borso/shared-infra test:coverage
fi

# DSQL compatibility check on staged migration SQL files. Cheap (~50 ms)
# enough to be unconditional, but the find inside is no-op when no
# migration is staged so unrelated work isn't slowed down. Rung-2
# eradication of docs/dantotsus/dsql-alter-table-only-add-column.md —
# the dangerous DDL forms can no longer land in a commit.
if echo "$changed" | grep -q 'api/src/database/migrations/.*\.sql$'; then
  echo "[pre-commit] migration SQL changed — running DSQL-compat check"
  ./scripts/check-migration-sql-dsql-compat.sh
fi
