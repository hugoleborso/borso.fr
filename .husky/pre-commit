set -e

# Pre-commit holds only checks that are cheap and that should be true of every
# single commit, so committing stays fast enough that nobody reaches for
# --no-verify. Anything that needs the whole branch in view, or that takes more
# than a second or two, lives in .husky/pre-push instead.
#
# The split, so the next person editing these files keeps it:
#
#   pre-commit  a per-file invariant, cheap, and true of every commit
#   pre-push    needs the branch in view, or costs real time

changed=$(git diff --cached --name-only --diff-filter=ACMR)

# ESLint and Prettier over the STAGED files only. Linting the whole repository
# here would not be a small check: the type-aware rules build a TypeScript
# program per workspace, so a cold full run is about 80 s, and a branch that
# touches many files thrashes the cache and pays most of that on every commit.
#
# Whole-repository linting still happens, in ci.yml, where it also catches the
# cross-file rules that a staged-file run cannot see, e.g. import-x/no-cycle.
# So the commit gate is fast and local, and the branch gate is exhaustive.
#
# Rung-1 eradication, together with the ci.yml backup, of
# docs/dantotsus/biome-lint-was-not-gated-anywhere.md.
staged_lintable=$(echo "$changed" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs)$' || true)
if [ -n "$staged_lintable" ]; then
  echo "[pre-commit] running eslint on staged files"
  echo "$staged_lintable" | xargs pnpm exec eslint --no-warn-ignored --cache --cache-strategy content --cache-location .eslintcache
fi

staged_formattable=$(echo "$changed" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|css|ya?ml|html)$' || true)
if [ -n "$staged_formattable" ]; then
  echo "[pre-commit] running prettier on staged files"
  echo "$staged_formattable" | xargs pnpm exec prettier --check --cache --ignore-unknown
fi

# DSQL compatibility of staged migration SQL. The find inside is a no-op when
# no migration is staged, so unrelated work is not slowed down. Rung-2
# eradication of docs/dantotsus/dsql-alter-table-only-add-column.md.
if echo "$changed" | grep -q 'api/src/database/migrations/.*\.sql$'; then
  echo "[pre-commit] migration SQL changed — running DSQL-compat check"
  ./scripts/check-migration-sql-dsql-compat.sh
fi

# Blueprint annotations, whenever source changed. A `@Blueprint` missing a tag
# still lands in the index with an empty cell, and a `// @FollowsBlueprint` that
# names nothing still reads as adoption, so neither fails anything on its own.
# The check also refuses a stale index, which is what stops an annotation from
# being added without the generated file catching up. One pass over the tree,
# well under a second, so it belongs on the commit.
if [ -n "$staged_lintable" ]; then
  echo "[pre-commit] checking blueprint annotations"
  pnpm exec tsx .claude/skills/blueprint/blueprint-indexing.ts --check
  pnpm exec tsx .claude/skills/blueprint/blueprint-heatmap.ts --check
fi

# One stylesheet per application. A second CSS file is how an application
# drifts back to global class names, because the first rule that does not fit a
# utility goes there and the rest follow. A git-index read of four directories,
# so it costs nothing and belongs on the commit.
echo "[pre-commit] checking each app ships one stylesheet"
scripts/check-single-stylesheet.sh

# A `VITE_*` variable a site reads and no workflow sets is a feature that never
# runs, in every stage, silently: Vite substitutes `undefined` at build time and
# nothing fails. A git-index read plus a grep over the workflows, so it costs
# nothing and belongs on the commit. Rung-2 eradication of
# docs/dantotsus/a-feature-that-was-never-switched-on-in-any-stage.md.
echo "[pre-commit] checking each VITE_ variable a site reads is wired"
scripts/check-frontend-env-vars.sh

# A manifest naming an icon that is not there installs a grey square, and the
# build, the tests, the linter and the page all keep passing. A JSON parse plus
# a handful of stat calls, so it costs nothing and belongs on the commit.
echo "[pre-commit] checking each manifest names icons that ship"
scripts/check-pwa-assets.sh

# A knowledge entry saying a tool is broken steers every future agent away from
# it and never expires on its own — two phone audits obeyed one that was wrong.
# A grep over one directory, so it costs nothing and belongs on the commit.
echo "[pre-commit] checking every \"does not work\" carries a date"
scripts/check-negative-claims-are-dated.sh

# A pure module whose only consumer is its own test scores 100% on the coverage
# and mutation gates while running nowhere, and knip cannot see it because every
# test file is a knip entry point. A git-index read plus a grep, so it costs
# nothing and belongs on the commit. Rung-2 eradication of
# docs/dantotsus/three-green-gates-on-code-that-ran-nowhere.md.
echo "[pre-commit] checking each pure module has a caller"
scripts/check-pure-modules-have-callers.sh

# A non-module <script src> tag ships un-bundled and 404s in preview and
# production. A grep over the app HTML, so it costs nothing and belongs on the
# commit rather than the push. Rung-2 eradication of
# docs/dantotsus/vite-non-module-script-tags-arent-bundled.md.
echo "[pre-commit] checking app HTML for non-module <script src> tags"
scripts/check-non-module-scripts.sh

# `deploy`, `destroy`, `install`, `update`, `sync`, `fetch` and `publish` are
# pnpm built-ins. Without `run`, pnpm shadows the package's scripts entry and
# silently does the wrong thing. Another instant grep of a standing invariant.
# Rung-2 eradication of docs/dantotsus/pnpm-reserved-script-names.md.
echo "[pre-commit] checking workflows for pnpm reserved-name shadowing"
PNPM_RESERVED_REGEX='pnpm[[:space:]]+--filter[[:space:]]+("[^"]+"|[^[:space:]]+)[[:space:]]+(deploy|destroy|install|update|sync|fetch|publish)([[:space:]]|$)'
if grep -nrE "$PNPM_RESERVED_REGEX" .github/workflows/ >&2; then
  echo "[pre-commit] ERROR: above lines invoke a pnpm built-in instead of a package script." >&2
  echo "[pre-commit] Use 'pnpm --filter <pkg> run <name>' to force script lookup." >&2
  exit 1
fi
