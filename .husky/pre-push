set -e

# Pre-push gates the commits being pushed, not the branch.
#
# It used to key every check on `git merge-base HEAD origin/main`, which on a
# long branch means "everything, every time": a one-line change to a shell
# script re-ran four coverage suites and four full mutation suites, about fifty
# minutes, to prove that nothing had moved. A gate that expensive gets skipped,
# and a skipped gate is the thing this repository keeps rediscovering.
#
# So the range is the push itself. Git feeds this hook one line per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# and <remote sha> is the commit the remote branch is currently at, or all
# zeros when the branch is new. Gating on <remote sha>..HEAD means each push
# pays only for what it adds. The chain holds as long as no push is skipped,
# which is what the full suite in CD exists to backstop — see
# .github/workflows/full-suite.yml, which runs everything unscoped on main.
#
# The cheap per-commit invariants live in .husky/pre-commit.

push_base=''
pushed_ref=''
pushes_a_commit=''
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in *[!0]*) pushes_a_commit=1 ;; esac
  # A remote sha of all zeros means the branch does not exist upstream yet.
  case "$remote_sha" in
    *[!0]*)
      push_base="$remote_sha"
      pushed_ref="${remote_ref#refs/heads/}"
      break
      ;;
  esac
done

# Git runs this hook with no ref line when everything is up to date, and the
# empty base below would then gate the whole branch: eight minutes after a
# failed commit on the sweep of PR #395.
if [ -z "$pushes_a_commit" ]; then
  echo "[pre-push] no commit to push, no gate to run"
  exit 0
fi

# The remote branch sits on a commit this checkout has never fetched: another
# session pushed to the same branch. Git refuses a plain push over it only after
# every gate below has run, and a force push would discard that session's work,
# so stop before either. Twice on PR #118 two sessions merged main into one
# branch at once and the second push waited out ten minutes of gates to be
# rejected. See docs/dantotsus/two-sessions-one-branch.md.
if [ -n "$push_base" ] && ! git cat-file -e "$push_base^{commit}" 2>/dev/null; then
  echo "[pre-push] origin/$pushed_ref is at $push_base, a commit this checkout has never fetched:" >&2
  echo "  another session pushed to this branch. Bring its work in, then push again:" >&2
  echo "    git fetch origin $pushed_ref && git merge origin/$pushed_ref" >&2
  exit 1
fi

# Both bases below are read off the local `origin/main`, and nothing in an
# ordinary session updates that ref. A hosted container clones once and never
# fetches again, so it can be tens of commits behind by the time anything is
# pushed — measured here on 2026-08-20, twenty-five commits, which turned a
# one-line change to .claude/settings.json into 520 gated files and six full
# mutation suites. The same push gated 1 file once main was fetched. This hook
# is about to open a connection to the same remote either way, so the refresh
# costs one round-trip and buys back the scoping this file exists for.
git fetch --quiet origin main 2>/dev/null || true

# A sweep removes at least as much as it adds. CI ran this only once the pull
# request was open, and the sweep of PR #395 answered its red with "as expected".
case "$(git branch --show-current)" in
  claude/lessons-from-*) scripts/kaizen.sh balance || exit 1 ;;
esac

# A branch that conflicts with main gets no CI at all. GitHub cannot build
# refs/pull/<n>/merge for it, so it dispatches no workflow run: no red check, an
# empty list. See docs/knowledge/a-conflicted-pull-request-gets-no-checks.md.
# This used to be a warning printed after every gate had run and the push had
# landed. On PR #252 main moved under the branch, the warning came after the
# push, and CI stayed silent until origin/main was merged in. So it refuses
# here, before the gates, on the main this hook has just fetched.
#
# It asks the merge GitHub makes, not the one this checkout would make. Local
# merges read `.gitattributes` from the worktree, and GitHub's merge ref honours
# no merge driver. On PR #351 the branch still declared `merge=union` for
# docs/adr/README.md, which main had dropped: the local merge came out clean, the
# guard let 4c0193b through, and GitHub ran no CI on it for 80 minutes. The same
# union merge, on PR #353, put back on main the ADR index PR #352 had deleted.
# Attributes are read from the empty tree here, so no driver applies. Git before
# 2.40 ignores GIT_ATTR_SOURCE and falls back to the worktree's.
#
# `merge-tree --write-tree` exits 1 on a conflict and above 1 on an error.
# Best-effort: a missing origin/main (shallow clone, fresh worktree) or an error
# skips it rather than blocking a push over a diagnostic.
if git rev-parse --verify --quiet origin/main >/dev/null; then
  empty_tree=$(git hash-object -t tree /dev/null)
  conflict_status=0
  GIT_ATTR_SOURCE="$empty_tree" git merge-tree --write-tree --name-only HEAD origin/main \
    >/dev/null 2>&1 || conflict_status=$?
  if [ "$conflict_status" -eq 1 ]; then
    echo "[pre-push] this branch conflicts with origin/main, so GitHub would run no CI on it." >&2
    echo "  Merge main in, resolve, then push again:" >&2
    echo "    git merge origin/main" >&2
    echo "[hook] Nothing in this call ran. In a chained command, rerun the other steps on their own." >&2
    [ -f KAIZEN.md ] && [ "${KAIZEN_LOG_REFUSALS:-1}" != 0 ] &&
      scripts/kaizen.sh --from hook:pre-push-conflict "pre-push refused a branch that conflicts with origin/main" >/dev/null 2>&1
    exit 1
  fi
fi

# The base this push is gated against: the remote sha on an ordinary push, main
# for a new or rewritten branch, and the automatic merge of the two gated
# states on the push that merges main in. scripts/pre-push-range.sh holds the
# reasons and scripts/pre-push-range.test.ts the cases.
range=$(scripts/pre-push-range.sh "$push_base")
push_base=$(printf '%s\n' "$range" | sed -n 1p)
range_label=$(printf '%s\n' "$range" | sed -n 2p)

changed=$(git diff --name-only "$push_base" HEAD)
echo "[pre-push] gating $(echo "$changed" | grep -c . ) changed file(s) — range: $range_label"

if [ -z "$changed" ]; then
  echo "[pre-push] nothing changed in this range; skipping the file-scoped gates"
fi

# Runs a labelled gate in the background, capturing its output so parallel jobs
# do not interleave. Logs are printed only for the gates that fail.
#
# The gates (type checks, knip, oxlint, the changed tests) run side by side, at
# most `gate_limit` at once. Unbounded, they ran the sandbox out of memory and
# the tests that lost the race for CPU timed out, each passing alone.
# BORSO_PRE_PUSH_JOBS overrides the limit. See
# docs/dantotsus/the-gates-that-timed-each-other-out.md.
gate_log_dir=$(mktemp -d)
running_gates=''
failed=''
cores=$(nproc 2>/dev/null || echo 2)
gate_limit=${BORSO_PRE_PUSH_JOBS:-$((cores / 2))}
[ "$gate_limit" -ge 1 ] 2>/dev/null || gate_limit=1

# Each running gate is one `<pid>:<name>:<started at>` word, and writes its exit
# status beside its log when it ends. A gate is reaped when it finishes,
# whichever one that is: reaping the oldest first held every
# free slot behind the slowest gate, and the type checker, the slowest, is
# started first on purpose.
running_count() {
  set -- $running_gates
  echo $#
}

reap_finished_gates() {
  still_running=''
  reaped=0
  for entry in $running_gates; do
    pid=${entry%%:*}
    rest=${entry#*:}
    name=${rest%%:*}
    started=${rest#*:}
    if [ ! -f "$gate_log_dir/$name.status" ]; then
      still_running="$still_running $entry"
      continue
    fi
    reaped=1
    wait "$pid" || true
    if [ "$(cat "$gate_log_dir/$name.status")" -eq 0 ]; then
      echo "[pre-push] pass: $name ($(($(date +%s) - started)) s)"
    else
      echo "[pre-push] fail: $name ($(($(date +%s) - started)) s)"
      failed="$failed $name"
    fi
  done
  running_gates="$still_running"
  [ "$reaped" -eq 1 ] || sleep 0.2
}

start_gate() {
  gate_name="$1"
  shift
  while [ "$(running_count)" -ge "$gate_limit" ]; do
    reap_finished_gates
  done
  echo "[pre-push] start: $gate_name"
  {
    if ( "$@" ) 8>&- >"$gate_log_dir/$gate_name.log" 2>&1; then gate_status=0; else gate_status=$?; fi
    echo "$gate_status" >"$gate_log_dir/$gate_name.status"
  } &
  running_gates="$running_gates $!:$gate_name:$(date +%s)"
}

wait_for_gates() {
  while [ "$(running_count)" -gt 0 ]; do
    reap_finished_gates
  done
  for name in $failed; do
    echo "" >&2
    echo "[pre-push] FAILED: $name" >&2
    cat "$gate_log_dir/$name.log" >&2
  done
  if [ -n "$failed" ]; then
    rm -rf "$gate_log_dir"
    exit 1
  fi
}

# One pre-push at a time on this machine. Parallel agents each push from their
# own worktree, and a limit inside one hook cannot see the others: the load
# average reached 40 with three of them pushing, and their gates timed out on
# each other. The lock is per machine, so a second push waits for the first
# instead of racing it. The gates are started with the lock's descriptor
# closed, so nothing they leave running can hold it.
if command -v flock >/dev/null 2>&1; then
  exec 8>"${TMPDIR:-/tmp}/borso-pre-push.lock"
  if ! flock -n 8; then
    echo "[pre-push] another checkout's pre-push is running its gates on this machine; waiting for it rather than racing it"
    flock 8
  fi
fi

# Every gate below reads node_modules, and a branch restarted from a newer main
# carries a lockfile the session never installed: knip then reports the new
# application's dependencies as unused and its binaries as unlisted. PR #107's
# sweep answered that with a warning on one restart path; PR #136 restarted by
# another and hit it again. pnpm keeps a copy of the lockfile it installed, so
# comparing the two is exact and costs nothing when they agree.
scripts/ensure-installed.sh pre-push

# Dead-code detection across the workspace. Push time rather than commit time,
# because a multi-commit branch legitimately passes through intermediate states
# where an export is written before its caller exists.
# Built once here, before the typecheck gates below all reach for it.
scripts/ensure-infra-built.sh

# The type checker, per changed app, started before anything else because it is
# the slowest gate: pragma's measured 47 s on 2026-10-24, and the push budget in
# docs/standards/14-tool-runtime-budgets.md is 60 s for a change confined to one
# application. Vitest strips types without checking them, so a test passing a
# value its props do not accept ran green here and failed CI's typecheck. See
# docs/dantotsus/the-test-only-ci-typechecked.md.
changed_app_slugs=$(echo "$changed" | sed -n 's|^apps/\([^/]*\)/.*|\1|p' | sort -u)
for app in $changed_app_slugs; do
  start_gate "typecheck-$app" pnpm --filter "@borso-app/$app" run typecheck
done

# Untracked files are skipped: the push does not carry them, and on PR #334 a
# running subagent's probe files held the main session's push. See
# docs/dantotsus/the-push-that-waited-for-another-agents-probe.md.
start_gate knip pnpm exec knip --preprocessor ./scripts/knip/skip-untracked-files.ts

# oxlint with every rule, the type-aware ones included, over the files this
# push changes. The commit runs the same rules in a program of the staged files
# only; here each file gets its workspace's whole program, so a finding that
# depends on a file the commit did not import shows up before CI. Unused
# disable directives are reported in one run with every rule. Warnings fail it through
# `denyWarnings` in .oxlintrc.json. Rung-1 eradication, with the commit and CI
# runs, of docs/dantotsus/biome-lint-was-not-gated-anywhere.md.
lint_changed_files() {
  echo "$changed" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs)$' |
    while IFS= read -r candidate; do [ -f "$candidate" ] && printf '%s\0' "$candidate"; done |
    xargs -0 --no-run-if-empty pnpm exec oxlint --type-aware
}
if echo "$changed" | grep -qE '\.(js|jsx|ts|tsx|mjs|cjs)$'; then
  start_gate oxlint lint_changed_files
fi

# Only the tests this push affects. `--changed <base>` walks Vitest's module
# graph, so it selects the test files that changed AND the test files that
# import a source file that changed, however deep the chain. Measured on
# borso-fr against a one-line change to labours.core.ts: 2 files and 53 tests
# in 2.9 s, against 16 files and 318 tests in about 40 s for the whole suite.
# It picked App.test.tsx, which reaches the changed file transitively — the
# graph is doing the work, not a filename convention.
#
# `--project core` on the full-stack apps keeps the back-e2e project out of it,
# because that one wants a Postgres this hook has no business booting. The
# back-e2e suites run in CI, per changed app.
#
# The same run carries the per-file coverage gate. Vitest's `coverage.changed`
# follows `--changed`, so it measures only the changed files the coverage
# include names, and the graph above selected every test that executes them.
# This comment used to say a changed-only run would report every untouched
# pure file at 0 %. It does not, and PR #238 met CI's coverage gate on
# calendar-feeds.schema.ts after this hook had passed; with `--coverage` the
# hook refuses that tree in 7 s (measured). See
# docs/dantotsus/the-coverage-gate-a-wrong-comment-kept-in-ci.md.
for app in $changed_app_slugs; do
  if grep -q '"test:core"' "apps/$app/package.json"; then
    start_gate "tests-$app" \
      pnpm --filter "@borso-app/$app" exec vitest run --project core --changed "$push_base" --coverage
  else
    start_gate "tests-$app" \
      pnpm --filter "@borso-app/$app" exec vitest run --changed "$push_base" --coverage
  fi
done

# The tests of infra/cdk, infra/shared and the tooling this push affects. Their
# coverage gate runs in CI.
if echo "$changed" | grep -q '^infra/cdk/'; then
  start_gate infra-cdk pnpm --filter @borso/infra exec vitest run --changed "$push_base"
fi

# infra/shared's tests import `@borso/infra` through its built package entry.
test_infra_shared() {
  pnpm --filter @borso/infra run build &&
    pnpm --filter @borso/shared-infra exec vitest run --changed "$push_base"
}
if echo "$changed" | grep -q '^infra/shared/'; then
  start_gate infra-shared test_infra_shared
fi

if echo "$changed" | grep -qE '^(scripts|eslint-rules)/'; then
  start_gate tooling pnpm exec vitest run --changed "$push_base"
fi

# The 3S board's page, rendered in a real Chromium. It ships to a dashboard
# artifact rather than to a site, so no preview deploy, dev server or visual
# validation ever draws it and the operator's phone was its first renderer:
# three of PR #281's defects were found there. Push time rather than commit
# time, because launching a browser costs 4.2 s measured on 2026-11-09, which
# is over the 300 ms a pre-commit check gets in
# docs/standards/14-tool-runtime-budgets.md and well inside the 60 s this hook
# gets. CI runs the same check behind its own paths filter. See
# docs/dantotsus/the-page-nobody-rendered-before-the-operator.md.
if echo "$changed" | grep -qE '^scripts/quality/(dashboard/|dashboard-page\.core\.ts|check-dashboard-page\.ts)'; then
  start_gate dashboard-page pnpm exec tsx scripts/quality/check-dashboard-page.ts
fi

# Mutation testing runs in CI, on the pull request: scripts/mutate-changed.sh.

wait_for_gates

rm -rf "$gate_log_dir"
exec 8>&-

# Workflow lint. Catches paths-filter base misuses, deprecated action versions,
# and shell-quoting bugs in `run:` blocks. Stays on push because it needs a
# binary that is not always installed. Rung-2 eradication of
# docs/dantotsus/paths-filter-base-head1-on-push.md.
#
# The skip is only tolerable when the push does not touch a workflow. It was
# not: this branch changed ci.yml and preview.yml, the binary had silently
# never been installed, and the push went through on a WARN. A gate that
# excuses itself on exactly the pushes that need it is not a gate.
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] running actionlint"
  actionlint
elif echo "$changed" | grep -q '^\.github/workflows/'; then
  echo "[pre-push] actionlint is not installed and this push changes a workflow." >&2
  echo "[pre-push] Install it, then push again:  ./scripts/install-repo-deps.sh" >&2
  exit 1
else
  echo "[pre-push] WARN: actionlint not installed — skipping. No workflow changed in this push, so nothing was skipped that matters. Install via ./scripts/install-repo-deps.sh." >&2
fi

# Detection nudge: agent-authored branches almost always have an open pull
# request with reviewer threads. Print a reminder so the agent's next response
# addresses unresolved threads before treating "push succeeded" as the
# all-clear. Rung-4 eradication of
# docs/dantotsus/pushed-without-reading-pr-review-comments.md.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')
case "$current_branch" in
  claude/*)
    printf '\n⚠️  [pre-push] pushing on %s.\n' "$current_branch" >&2
    printf '   If this branch has an open PR, address any unresolved review\n' >&2
    printf '   thread written by hugoleborso; skip every other one.\n' >&2
    # Every local gate passing is not the branch passing: CI runs suites this
    # hook scopes away. See
    # docs/dantotsus/one-sample-could-not-tell-the-hook-from-the-runner.md.
    printf '   CI has not run on %s yet. Call the branch passing only once\n' "$(git rev-parse --short HEAD)" >&2
    printf '   get_check_runs for this sha is green.\n\n' >&2
    # The validation gate reads a pull request only when it opens, and PR #354
    # gained its API after opening, so it merged unreviewed. The operator chose
    # a notice over a refusal on 2026-11-15: run the review before the last
    # push and its report rides with it, at no extra CI run. See
    # docs/dantotsus/the-review-gate-that-only-watched-the-door.md.
    branch_changes=$(git diff --name-only origin/main...HEAD 2>/dev/null || true)
    api_changes=$(printf '%s\n' "$branch_changes" | grep -cE '^apps/[^/]+/api/' || true)
    if [ "$api_changes" -gt 0 ] && ! printf '%s\n' "$branch_changes" | grep -qE '^docs/features/[^/]+/[^/]+/validation/technical-validation-[^/]+\.md$'; then
      printf '⚠️  [pre-push] this branch changes %s file(s) under apps/*/api/ and carries no technical-validation report.\n' "$api_changes" >&2
      printf '   The review is owed before merge. Run /technical-validation on the finished work and push its report with your last change.\n\n' >&2
    fi

    ;;
esac
