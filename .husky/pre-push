set -e

# Pre-push holds the checks that need the whole branch in view, or that cost
# real time. The cheap per-commit invariants live in .husky/pre-commit.

# Dead-code detection across the workspace. Push time rather than commit time,
# because a multi-commit branch legitimately passes through intermediate states
# where an export is written before its caller exists.
echo "[pre-push] running knip"
pnpm exec knip

# Full coverage suites for the infra packages, including their 100% thresholds.
# Moved here from pre-commit: a CDK snapshot suite takes about 25 s, which is
# too slow to sit on every commit, and nothing about it needs to run more often
# than once per push.
changed_since_main=$(git diff --name-only "$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)" HEAD)

if echo "$changed_since_main" | grep -q '^infra/cdk/'; then
  echo "[pre-push] infra/cdk/ changed — running @borso/infra test:coverage"
  pnpm --filter @borso/infra test:coverage
fi

if echo "$changed_since_main" | grep -q '^infra/shared/'; then
  echo "[pre-push] infra/shared/ changed — running @borso/shared-infra test:coverage"
  pnpm --filter @borso/shared-infra test:coverage
fi

# Mutation testing on the pure files of every workspace whose `*.core.ts` or
# `*.utils.ts` files changed on this branch. Coverage says a line ran; a
# surviving mutant says no assertion noticed a change to it, which is the
# signal docs/standards/10-testing.md actually asks for.
#
# Scoped to changed workspaces because a full run over all four applications
# takes tens of minutes. Set SKIP_MUTATION_GATE=1 for a work-in-progress push,
# and never for a push you intend to merge.
if [ "${SKIP_MUTATION_GATE:-0}" != "1" ]; then
  base_ref=$(git merge-base HEAD origin/main 2>/dev/null || echo '')
  if [ -n "$base_ref" ]; then
    changed_pure_files=$(git diff --name-only "$base_ref" HEAD -- 'apps/*/**/*.core.ts' 'apps/*/**/*.utils.ts')
    changed_apps=$(echo "$changed_pure_files" | sed -n 's|^apps/\([^/]*\)/.*|\1|p' | sort -u)
    for app in $changed_apps; do
      echo "[pre-push] pure files changed in $app — running mutation tests"
      pnpm --filter "@borso-app/$app" run test:mutation
    done
  fi
fi

# Workflow lint. Catches paths-filter base misuses, deprecated action versions,
# and shell-quoting bugs in `run:` blocks. Stays on push because it needs a
# binary that is not always installed. Rung-2 eradication of
# docs/dantotsus/paths-filter-base-head1-on-push.md.
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] running actionlint"
  actionlint
else
  echo "[pre-push] WARN: actionlint not installed — skipping. Install via the SessionStart hook (.claude/hooks/session-start.sh)." >&2
fi

# Detection nudge: agent-authored branches almost always have an open pull
# request with reviewer threads. Print a reminder so the agent's next response
# addresses unresolved threads before treating "push succeeded" as the
# all-clear. Rung-4 eradication of
# docs/dantotsus/pushed-without-reading-pr-review-comments.md.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')
case "$current_branch" in
  claude/*)
    printf '\n⚠️  [pre-push] pushing on %s.\n' "$current_branch" >&2
    printf '   If this branch has an open PR, fetch and address any\n' >&2
    printf '   unresolved review threads BEFORE relying on this push.\n' >&2
    printf '   Use: mcp__github__pull_request_read method:get_review_comments\n\n' >&2
    ;;
esac
