set -e

# Pre-push gates the commits being pushed, not the branch.
#
# It used to key every check on `git merge-base HEAD origin/main`, which on a
# long branch means "everything, every time": a one-line change to a shell
# script re-ran four coverage suites and four full mutation suites, about fifty
# minutes, to prove that nothing had moved. A gate that expensive gets skipped,
# and a skipped gate is the thing this repository keeps rediscovering.
#
# So the range is the push itself. Git feeds this hook one line per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# and <remote sha> is the commit the remote branch is currently at, or all
# zeros when the branch is new. Gating on <remote sha>..HEAD means each push
# pays only for what it adds. The chain holds as long as no push is skipped,
# which is what the full suite in CD exists to backstop — see
# .github/workflows/full-suite.yml, which runs everything unscoped on main.
#
# The cheap per-commit invariants live in .husky/pre-commit.

push_base=''
pushed_ref=''
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  # A remote sha of all zeros means the branch does not exist upstream yet.
  case "$remote_sha" in
    *[!0]*)
      push_base="$remote_sha"
      pushed_ref="${remote_ref#refs/heads/}"
      break
      ;;
  esac
done

# The remote branch sits on a commit this checkout has never fetched: another
# session pushed to the same branch. Git refuses a plain push over it only after
# every gate below has run, and a force push would discard that session's work,
# so stop before either. Twice on PR #118 two sessions merged main into one
# branch at once and the second push waited out ten minutes of gates to be
# rejected. See docs/dantotsus/two-sessions-one-branch.md.
if [ -n "$push_base" ] && ! git cat-file -e "$push_base^{commit}" 2>/dev/null; then
  echo "[pre-push] origin/$pushed_ref is at $push_base, a commit this checkout has never fetched:" >&2
  echo "  another session pushed to this branch. Bring its work in, then push again:" >&2
  echo "    git fetch origin $pushed_ref && git merge origin/$pushed_ref" >&2
  exit 1
fi

# Both bases below are read off the local `origin/main`, and nothing in an
# ordinary session updates that ref. A hosted container clones once and never
# fetches again, so it can be tens of commits behind by the time anything is
# pushed — measured here on 2026-08-20, twenty-five commits, which turned a
# one-line change to .claude/settings.json into 520 gated files and six full
# mutation suites. The same push gated 1 file once main was fetched. This hook
# is about to open a connection to the same remote either way, so the refresh
# costs one round-trip and buys back the scoping this file exists for.
git fetch --quiet origin main 2>/dev/null || true

# A remote sha that HEAD does not descend from means the push rewrites the
# branch: a force push after `git checkout -B <branch> origin/main`, which is
# how a branch whose pull request was squash-merged starts its next piece of
# work. Diffing against that sha gates everything main changed between the two
# bases. Measured on PR #174: a one-commit branch gated 774 files, four
# applications of tests and six mutation suites over 79 files, and the push
# outlived its ten-minute command timeout. Such a branch is new work on main, so its base is main.
# See docs/dantotsus/a-force-push-re-gated-everything-main-had-merged.md.
if [ -n "$push_base" ] && git cat-file -e "$push_base" 2>/dev/null &&
  git merge-base --is-ancestor "$push_base" HEAD 2>/dev/null; then
  range_label="this push"
elif [ -n "$push_base" ] && git cat-file -e "$push_base" 2>/dev/null; then
  push_base=$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)
  range_label="the whole branch since main (the push rewrites the branch)"
else
  push_base=$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)
  range_label="the whole branch since main (no remote ref for this branch yet)"
fi

# One push legitimately adds work nobody here has to gate: the one that merges
# origin/main in. Its range carries every commit main made since the branch
# last pushed, and those were gated when they landed — unscoped, by
# .github/workflows/full-suite.yml. Keying on <remote sha> alone re-gates all
# of them: measured on this repository, merging main into a two-day branch
# turned 46 commits into 491 changed files, four applications of tests and 78
# mutated files, and the push timed out twice before anyone understood it was
# working as designed.
#
# The newest main commit this branch has merged is `git merge-base HEAD
# origin/main`, and diffing against it rather than the remote sha leaves exactly
# the branch's own work: the same push drops from 491 files to 23. It cannot
# under-gate. A file main changed and this branch took verbatim is identical to
# that commit, so it falls out of the range, which is right, main gated it. A
# file both sides touched, or the branch alone touched, still differs and is
# still gated.
#
# It is the merge base and not main's tip because the fetch above moves the
# tip. This used to diff against origin/main itself, after checking that the
# tip was an ancestor of HEAD; whenever main moved between the merge and the
# push, which in a session merging nine pull requests was every push, the
# check failed, the narrowing never happened, and one push mutated 81 talos
# files that main had brought in. See
# docs/dantotsus/the-fetch-that-undid-the-narrowing.md.
#
# The ancestry test is what keeps this off an ordinary push: on a branch that
# has not merged main since its last push, the merge base is already an
# ancestor of the remote sha, and the remote sha is the tighter base.
main_merged=$(git merge-base HEAD origin/main 2>/dev/null || true)
if [ -n "$main_merged" ] &&
  ! git merge-base --is-ancestor "$main_merged" "$push_base" 2>/dev/null; then
  push_base="$main_merged"
  range_label="this push, minus the commits it merged from origin/main"
fi

changed=$(git diff --name-only "$push_base" HEAD)
echo "[pre-push] gating $(echo "$changed" | grep -c . ) changed file(s) — range: $range_label"

if [ -z "$changed" ]; then
  echo "[pre-push] nothing changed in this range; skipping the file-scoped gates"
fi

# Runs a labelled gate in the background, capturing its output so parallel jobs
# do not interleave. Logs are printed only for the gates that fail.
#
# At most `gate_limit` gates run at once. Starting all of them together put
# four Stryker runs, a coverage suite, the typechecks and every app's tests on
# a four-core sandbox at once, and the tests that lost the race for CPU timed
# out: the infra-cdk synth tests, talos App.test.tsx, the eslint-rules suites,
# each passing alone. A timeout reads as a failing test, so five agents in one
# weekend pushed two and three times over failures that were only load.
# BORSO_PRE_PUSH_JOBS overrides the limit. See
# docs/dantotsus/the-gates-that-timed-each-other-out.md.
gate_log_dir=$(mktemp -d)
running_pids=''
running_names=''
failed=''
cores=$(nproc 2>/dev/null || echo 2)
gate_limit=${BORSO_PRE_PUSH_JOBS:-$((cores / 2))}
[ "$gate_limit" -ge 1 ] 2>/dev/null || gate_limit=1

running_count() {
  set -- $running_pids
  echo $#
}

reap_oldest_gate() {
  set -- $running_pids
  pid=$1
  shift
  running_pids="$*"
  set -- $running_names
  name=$1
  shift
  running_names="$*"
  if wait "$pid"; then
    echo "[pre-push] pass: $name"
  else
    failed="$failed $name"
  fi
}

start_gate() {
  gate_name="$1"
  shift
  while [ "$(running_count)" -ge "$gate_limit" ]; do
    reap_oldest_gate
  done
  echo "[pre-push] start: $gate_name"
  ( "$@" ) 8>&- >"$gate_log_dir/$gate_name.log" 2>&1 &
  running_pids="$running_pids $!"
  running_names="$running_names $gate_name"
}

wait_for_gates() {
  while [ "$(running_count)" -gt 0 ]; do
    reap_oldest_gate
  done
  for name in $failed; do
    echo "" >&2
    echo "[pre-push] FAILED: $name" >&2
    cat "$gate_log_dir/$name.log" >&2
  done
  if [ -n "$failed" ]; then
    rm -rf "$gate_log_dir"
    exit 1
  fi
}

# One pre-push at a time on this machine. Parallel agents each push from their
# own worktree, and a limit inside one hook cannot see the others: the load
# average reached 40 with three of them pushing, and their gates timed out on
# each other. The lock is per machine, so a second push waits for the first
# instead of racing it. The gates are started with the lock's descriptor
# closed, so nothing they leave running can hold it.
if command -v flock >/dev/null 2>&1; then
  exec 8>"${TMPDIR:-/tmp}/borso-pre-push.lock"
  if ! flock -n 8; then
    echo "[pre-push] another checkout's pre-push is running its gates on this machine; waiting for it rather than racing it"
    flock 8
  fi
fi

# Every gate below reads node_modules, and a branch restarted from a newer main
# carries a lockfile the session never installed: knip then reports the new
# application's dependencies as unused and its binaries as unlisted. PR #107's
# sweep answered that with a warning on one restart path; PR #136 restarted by
# another and hit it again. pnpm keeps a copy of the lockfile it installed, so
# comparing the two is exact and costs nothing when they agree.
if ! cmp -s pnpm-lock.yaml node_modules/.pnpm/lock.yaml; then
  echo "[pre-push] pnpm-lock.yaml changed since the last install; installing before the gates read node_modules"
  pnpm install --frozen-lockfile
fi

# Dead-code detection across the workspace. Push time rather than commit time,
# because a multi-commit branch legitimately passes through intermediate states
# where an export is written before its caller exists. Runs alongside the infra
# suites rather than in front of them.
# Built once here, before the typecheck gates below all reach for it.
scripts/ensure-infra-built.sh

start_gate knip pnpm exec knip

if echo "$changed" | grep -q '^infra/cdk/'; then
  start_gate infra-cdk pnpm --filter @borso/infra test:coverage
fi

if echo "$changed" | grep -q '^infra/shared/'; then
  start_gate infra-shared pnpm --filter @borso/shared-infra test:coverage
fi

# The repository's own tooling, held to the bar it holds the applications to.
# The mutation loop below iterates `apps/*` and the root is not one of them, so
# a generator that decides whether a standard is enforced reached full coverage
# and was never mutated. The suite is 13 s whole, so it needs no `--changed`.
if echo "$changed" | grep -qE '^(scripts|eslint-rules)/'; then
  start_gate tooling pnpm run test:coverage
  start_gate typecheck-tooling pnpm run typecheck
fi

# Only the tests this push affects. `--changed <base>` walks Vitest's module
# graph, so it selects the test files that changed AND the test files that
# import a source file that changed, however deep the chain. Measured on
# borso-fr against a one-line change to labours.core.ts: 2 files and 53 tests
# in 2.9 s, against 16 files and 318 tests in about 40 s for the whole suite.
# It picked App.test.tsx, which reaches the changed file transitively — the
# graph is doing the work, not a filename convention.
#
# `--project core` on the full-stack apps keeps the back-e2e project out of it,
# because that one wants a Postgres this hook has no business booting. The
# back-e2e suites run in CI, per changed app.
#
# The per-file coverage gate is NOT here. A per-file threshold needs the whole
# suite that covers those files, so running it over a changed-only selection
# would report every untouched pure file at 0 %. It runs in CI on each changed
# app, and unscoped on main in full-suite.yml.
changed_app_slugs=$(echo "$changed" | sed -n 's|^apps/\([^/]*\)/.*|\1|p' | sort -u)
# The type checker, per changed app. Vitest strips types without checking them,
# so a test passing a value its props do not accept ran green here and failed
# CI's typecheck. pragma's takes about 28 s and runs beside the other gates.
# See docs/dantotsus/the-test-only-ci-typechecked.md.
for app in $changed_app_slugs; do
  start_gate "typecheck-$app" pnpm --filter "@borso-app/$app" run typecheck
done
for app in $changed_app_slugs; do
  if grep -q '"test:core"' "apps/$app/package.json"; then
    start_gate "tests-$app" \
      pnpm --filter "@borso-app/$app" exec vitest run --project core --changed "$push_base"
  else
    start_gate "tests-$app" \
      pnpm --filter "@borso-app/$app" exec vitest run --changed "$push_base"
  fi
done

# Mutation testing, scoped to the gated files this push actually touches: the
# pure ones, plus the adapters, which the coverage and mutation configs cover
# for the same reason. A gate that is armed everywhere except at the moment a
# file changes is the shape this repository keeps rediscovering.
#
# Coverage says a line ran; a surviving mutant says no assertion noticed a
# change to it, which is the signal docs/standards/10-testing.md asks for. A
# full run over one application is fifteen to twenty-five minutes, so an
# unscoped gate is a gate nobody can afford on every push. Mutating only the
# changed files takes seconds, and the unscoped run moves to CD.
#
# A changed *test* file pulls in its sibling source, because weakening a test
# is exactly how a mutant comes back to life without the source moving.
#
# Two things about `--mutate`, both measured rather than assumed:
#   - It does NOT accumulate. Passing the flag twice silently keeps the last
#     value only, so every file goes into one flag.
#   - The value is split on commas BEFORE globbing, so a brace expression is
#     wrong: `{a,b}` becomes the two patterns `{a` and `b}`, each matching
#     nothing, and `{a}` alone matches nothing either because a single-element
#     brace never expands. Stryker then instruments zero files and exits 1 on
#     "No tests were executed". Comma-separated plain paths, no braces.
# The mutation runs come after every other gate has finished, one at a time.
# Stryker takes every core it is given, and sharing the machine with the test
# gates is what timed those tests out: one CDK synth test measured 5s alone and
# passed 60s under the wave. Run alone, each Stryker run takes the whole machine
# and nothing else is waiting on a clock.
wait_for_gates
gate_limit=1
BORSO_MUTATION_RUNS_IN_FLIGHT=1
export BORSO_MUTATION_RUNS_IN_FLIGHT

if [ "${SKIP_MUTATION_GATE:-0}" != "1" ]; then
  for app in $changed_app_slugs; do
    # `|| true` because a grep that matches nothing exits 1, and a failing
    # command substitution inside an assignment aborts the hook under `set -e`.
    gated_files=$(echo "$changed" |
      sed -n "s|^apps/$app/||p" |
      # `-E` and a delimiter that is not `|`: inside `s|…|…|` a `\|` reads as an
      # escaped delimiter rather than as alternation, so this substitution
      # matched nothing at all and a changed test never pulled in its sibling
      # source — the one thing the comment above says it does.
      sed -E 's/\.(core|utils|adapter)\.test\.tsx?$/.\1.ts/' |
      grep -E '\.(core|utils|adapter)\.tsx?$' |
      # A rename shows up here as its old path too, and Stryker exits 1 on
      # "No tests were executed" when handed a file that is no longer there —
      # an error naming nothing about the cause, on a push whose only crime was
      # moving a file. The suffix work ahead is mostly renames.
      while read -r gated; do [ -n "$gated" ] && [ -f "apps/$app/$gated" ] && echo "$gated"; done |
      sort -u || true)
    [ -z "$gated_files" ] && continue
    mutate_glob=$(echo "$gated_files" | paste -sd, -)
    echo "[pre-push] $app: mutating $(echo "$gated_files" | grep -c .) changed gated file(s)"
    start_gate "mutation-$app" \
      pnpm --filter "@borso-app/$app" exec stryker run --mutate "$mutate_glob"
  done

  # The same scoping for the root workspace, whose gated files are the pure
  # modules under scripts/. Same two `--mutate` rules as above.
  tooling_files=$(echo "$changed" |
    sed -E 's/\.(core|utils)\.test\.ts$/.\1.ts/' |
    grep -E '^scripts/.*\.(core|utils)\.ts$' |
    while read -r gated; do [ -n "$gated" ] && [ -f "$gated" ] && echo "$gated"; done |
    sort -u || true)
  if [ -n "$tooling_files" ]; then
    echo "[pre-push] tooling: mutating $(echo "$tooling_files" | grep -c .) changed gated file(s)"
    start_gate mutation-tooling \
      pnpm exec stryker run --mutate "$(echo "$tooling_files" | paste -sd, -)"
  fi

  # And infra/cdk, whose five pure modules rewrite every migration before it
  # reaches DSQL. They sat at 100% coverage with no mutation configuration at
  # all until 2026-08-15, and the first run scored 80.84 with 69 survivors.
  infra_files=$(echo "$changed" |
    sed -E 's/\.utils\.test\.ts$/.utils.ts/' |
    sed -n 's|^infra/cdk/||p' |
    grep -E '^src/.*\.utils\.ts$' |
    while read -r gated; do [ -n "$gated" ] && [ -f "infra/cdk/$gated" ] && echo "$gated"; done |
    sort -u || true)
  if [ -n "$infra_files" ]; then
    echo "[pre-push] infra-cdk: mutating $(echo "$infra_files" | grep -c .) changed gated file(s)"
    start_gate mutation-infra-cdk \
      pnpm --filter @borso/infra exec stryker run --mutate "$(echo "$infra_files" | paste -sd, -)"
  fi
fi

# The wait for the mutation runs. It sits outside the SKIP_MUTATION_GATE branch
# above so that every gate this hook started is always awaited.
wait_for_gates

rm -rf "$gate_log_dir"
exec 8>&-

# Workflow lint. Catches paths-filter base misuses, deprecated action versions,
# and shell-quoting bugs in `run:` blocks. Stays on push because it needs a
# binary that is not always installed. Rung-2 eradication of
# docs/dantotsus/paths-filter-base-head1-on-push.md.
#
# The skip is only tolerable when the push does not touch a workflow. It was
# not: this branch changed ci.yml and preview.yml, the binary had silently
# never been installed, and the push went through on a WARN. A gate that
# excuses itself on exactly the pushes that need it is not a gate.
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] running actionlint"
  actionlint
elif echo "$changed" | grep -q '^\.github/workflows/'; then
  echo "[pre-push] actionlint is not installed and this push changes a workflow." >&2
  echo "[pre-push] Install it, then push again:  ./scripts/install-repo-deps.sh" >&2
  exit 1
else
  echo "[pre-push] WARN: actionlint not installed — skipping. No workflow changed in this push, so nothing was skipped that matters. Install via ./scripts/install-repo-deps.sh." >&2
fi

# Detection nudge: agent-authored branches almost always have an open pull
# request with reviewer threads. Print a reminder so the agent's next response
# addresses unresolved threads before treating "push succeeded" as the
# all-clear. Rung-4 eradication of
# docs/dantotsus/pushed-without-reading-pr-review-comments.md.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')
case "$current_branch" in
  claude/*)
    printf '\n⚠️  [pre-push] pushing on %s.\n' "$current_branch" >&2
    printf '   If this branch has an open PR, fetch and address any\n' >&2
    printf '   unresolved review threads BEFORE relying on this push.\n' >&2
    printf '   Use: mcp__github__pull_request_read method:get_review_comments\n\n' >&2

    # A pull request that conflicts with its base creates NO workflow run at
    # all — GitHub cannot build refs/pull/<n>/merge, so it dispatches nothing.
    # Not a red run: an empty checks list, forever, with the reason readable
    # only in `mergeable_state` on the API. That silence cost an hour on PR #63
    # even though docs/knowledge/a-conflicted-pull-request-gets-no-checks.md
    # had described it two days earlier, because nothing surfaced the entry at
    # the moment of the push. This is that entry's own local check, run for you.
    #
    # Best-effort: a missing origin/main (shallow clone, fresh worktree) skips
    # it rather than blocking a push over a diagnostic.
    #
    # The marker is matched as `^+<<<<<<<`, not `^<<<<<<<`: merge-tree prints
    # its conflict hunks as a diff, so every marker carries a `+` prefix and an
    # anchored match on the bare marker never fires. Checked against real
    # output before shipping, because a gate that cannot fire is worse than no
    # gate — it reads as a passing check.
    if git rev-parse --verify --quiet origin/main >/dev/null; then
      merge_base=$(git merge-base HEAD origin/main 2>/dev/null || true)
      if [ -n "$merge_base" ] &&
        git merge-tree "$merge_base" HEAD origin/main 2>/dev/null | grep -q '^+<<<<<<<'; then
        printf '⚠️  [pre-push] this branch CONFLICTS with origin/main.\n' >&2
        printf '   GitHub builds no merge ref for a conflicted pull request, so it\n' >&2
        printf '   will create no workflow run at all — no CI, no preview, no red\n' >&2
        printf '   check to tell you why. Merge origin/main in and push again.\n' >&2
        printf '   See docs/knowledge/a-conflicted-pull-request-gets-no-checks.md\n\n' >&2
      fi
    fi
    ;;
esac
